---
// Replaces Starlight's big page title with a small breadcrumb: Docs > Page title.
// The page title is still a real <h1 id="_top">, so the table of contents' "Overview"
// link and screen readers keep working; it's just styled as the last crumb.
const ROOT_LABEL = 'Docs';
const { title } = Astro.locals.starlightRoute.entry.data;
// Docs home page (the site's base path, always with a trailing slash).
const home = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<nav class="breadcrumb" aria-label="Breadcrumb">
	<a class="crumb truncate" href={home}>{ROOT_LABEL}</a>
	<svg
		class="chevron"
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="m9 18 6-6-6-6"></path>
	</svg>
	<h1 id="_top" class="crumb current truncate"><a href="#_top">{title}</a></h1>
</nav>

<style>
	.breadcrumb {
		--bc-size: var(--sl-text-sm); /* text size */
		--bc-muted: var(--sl-color-gray-3); /* "Docs" and the arrow */
		--bc-top: 1rem; /* space above the breadcrumb */
		display: flex;
		align-items: center;
		gap: 0.375rem;
		margin-top: var(--bc-top);
		font-size: var(--bc-size);
		line-height: 1.4;
		font-weight: 500;
		color: var(--bc-muted);
	}
	.crumb {
		min-width: 0;
	}
	a {
		--bc-fade: 0.15s ease; /* hover fade in and out */
		color: inherit;
		/* Underline is always there but transparent, so it can fade like the colour does. */
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.2em;
		transition:
			color var(--bc-fade),
			text-decoration-color var(--bc-fade);
	}
	/* Both crumbs turn the theme's accent blue on hover. */
	a:hover,
	a:focus-visible {
		color: var(--sl-color-text-accent);
		text-decoration-color: currentColor;
	}
	.truncate {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.chevron {
		flex: none;
		width: 1em;
		height: 1em;
	}
	/* The page title: same size as the rest of the breadcrumb, but brighter. */
	h1.current {
		margin: 0;
		font-size: inherit;
		line-height: inherit;
		font-weight: inherit;
		color: var(--sl-color-white);
		/* Clicking "Overview" jumps to this h1. Starlight leaves a 1.5rem gap above the jump target, so
		   cancel the breadcrumb's top margin here so the page lands at the very top. */
		scroll-margin-top: var(--bc-top);
	}
</style>

<style is:global>
	/* No divider under the title. Starlight draws it as a top border on the next panel and gives the
	   title's own panel 1.5rem of bottom padding. Drop both the line and that bottom padding: the
	   gap from the breadcrumb to the page content is then just the content panel's own 1.5rem. */
	.content-panel:has(.breadcrumb) {
		padding-bottom: 0;
	}
	.content-panel:has(.breadcrumb) + .content-panel {
		border-top: 0;
	}
</style>
