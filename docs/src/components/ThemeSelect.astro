---
// Replaces Starlight's light / dark / auto dropdown with one toggle button.
---

<button class="theme-toggle icon-btn" type="button" aria-label="Toggle light and dark theme" title="Toggle theme">
	<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
	</svg>
	<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
		<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
	</svg>
</button>

<script>
	document.addEventListener('click', (event) => {
		if (!(event.target as Element).closest('.theme-toggle')) return;
		const root = document.documentElement;
		const next = root.dataset.theme === 'light' ? 'dark' : 'light';
		root.dataset.theme = next;
		try {
			localStorage.setItem('starlight-theme', next);
		} catch {}
	});
</script>

<style is:global>
	/* dark: show the sun (click for light); light: show the moon (click for dark) */
	.theme-toggle .icon-moon { display: none; }
	:root[data-theme='light'] .theme-toggle .icon-sun { display: none; }
	:root[data-theme='light'] .theme-toggle .icon-moon { display: block; }
</style>
