---
import { getRepoStats } from '../utils/github';

const { repo, url, stars, forks, version } = await getRepoStats();
const fmt = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });
---

<a class="repo-card" href={url} target="_blank" rel="noopener noreferrer" aria-label={`${repo} on GitHub`}>
	<svg class="mark" viewBox="0 0 16 16" width="26" height="26" aria-hidden="true" fill="currentColor">
		<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
	</svg>
	<span class="meta">
		<span class="name">{repo}</span>
		<span class="stats">
			{version && (
				<span title="Latest release">
					<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="currentColor"><path d="M1 7.775V2.75C1 1.784 1.784 1 2.75 1h5.025c.464 0 .91.184 1.238.513l6.25 6.25a1.75 1.75 0 0 1 0 2.474l-5.026 5.026a1.75 1.75 0 0 1-2.474 0l-6.25-6.25A1.752 1.752 0 0 1 1 7.775Zm1.5 0c0 .066.026.13.073.177l6.25 6.25a.25.25 0 0 0 .354 0l5.025-5.025a.25.25 0 0 0 0-.354l-6.25-6.25a.25.25 0 0 0-.177-.073H2.75a.25.25 0 0 0-.25.25ZM6 5a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z" /></svg>
					{version}
				</span>
			)}
			{stars !== null && (
				<span title="Stars">
					<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" /></svg>
					{fmt.format(stars)}
				</span>
			)}
			{forks !== null && (
				<span title="Forks">
					<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="currentColor"><path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z" /></svg>
					{fmt.format(forks)}
				</span>
			)}
		</span>
	</span>
</a>

<style>
	.repo-card {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--sl-color-text);
		text-decoration: none;
		line-height: 1.2;
		padding: 0.25rem 0.5rem;
		border-radius: 0.4rem;
	}
	.repo-card:hover,
	.repo-card:focus-visible {
		background: color-mix(in srgb, var(--sl-color-white) 12%, transparent);
	}
	.meta {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}
	.name {
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}
	.stats {
		display: flex;
		gap: 0.65rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.stats span {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}
</style>