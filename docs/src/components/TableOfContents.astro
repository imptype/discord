		/* Regular pages: the sidebar (and its background) is exactly as wide as the left sidebar and pinned
		   to the right edge of the window, so the page stays centred with equal gaps on both sides. */
		html:root .right-sidebar:not(:has(.api-toc)) {
			inset-inline-start: auto;
			inset-inline-end: 0;
			width: var(--sl-sidebar-width);
