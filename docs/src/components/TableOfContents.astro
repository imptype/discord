		--pad-inline: 0.5rem;
		display: block;
		border-radius: 0.25rem;
		font-size: var(--sl-text-xs); /* same value Starlight gives these links; stated so --row-h can rely on it */
		padding-block: 0.25rem;
		padding-inline: calc(1rem * var(--d, 0) + var(--pad-inline)) var(--pad-inline);
		line-height: 1.25;
