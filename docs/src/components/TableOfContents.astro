	}

	/* Collapsed sections: the script adds .toc-hidden to every row inside one (headings, member lists, gaps). */
	.api-toc .toc-hidden {
		display: none !important;
	}

	/* The "v" button right after the text of headings that have sub-headings ("Core v"). Points down when open,
	   right when collapsed. */
	.api-toc li.has-kids {
		display: flex;
		align-items: stretch;
	}
	.api-toc li.has-kids > a {
		flex: none;
		padding-inline-end: 0.25rem; /* gap between the text and the button */
	}
	.api-toc .toc-toggle {
		flex: none;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.25rem;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0.25rem;
		background: none;
		color: var(--sl-color-gray-3);
		cursor: pointer;
	}
	.api-toc .toc-toggle:hover,
	.api-toc .toc-toggle:focus-visible {
