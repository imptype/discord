		html:root .right-sidebar-panel:not(:has(.api-toc)) {
			width: var(--sl-sidebar-width);
		}
		html:root .right-sidebar-panel:not(:has(.api-toc)) .sl-container {
			margin-inline: auto;
		}
		/* No empty strip under the lists (they now run to the bottom of the window) and less on the right, so the
