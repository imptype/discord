			width: max-content;
			max-width: 100%;
			max-height: var(--toc-max);
			overflow: clip;
		}
		/* Each list is as wide as its longest entry (no truncating, no wrapping). */
		.api-toc .toc-col {
			flex: none;
			will-change: transform;
		}
		.api-toc .toc-members {
			margin-top: 0;
			/* Level the first member with its class heading before any script has run: that many heading rows
			   (--row-h, see above), minus the member list's own top padding. Same number layout() measures. */
			padding-top: max(0rem, calc(var(--first-rows, 0) * var(--row-h) - var(--group-pad, 0.1875rem)));
			/* A little empty room under the last class, so when the list is scrolled to its end the "{"'s bottom
