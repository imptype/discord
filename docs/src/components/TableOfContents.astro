---
import Default from '@astrojs/starlight/components/TableOfContents.astro';

const { id, toc } = Astro.locals.starlightRoute;

// These pages get the two-column TOC; everything else uses Starlight's default.
// If a page has no TOC (toc is undefined), the default component renders nothing, like Starlight.
const dynamicPages = ['test/', 'reference/api'];
const dynamic = !!toc && dynamicPages.some((p) => id.startsWith(p));

type Item = { slug: string; text: string; depth: number; children: Item[] };
type Flat = { slug: string; text: string; depth: number; parent: string; kids: number };
const flat: Flat[] = [];
const walk = (items: Item[] = [], parent = '') => {
	for (const i of items) {
		flat.push({ slug: i.slug, text: i.text, depth: i.depth, parent, kids: i.children.length });
		walk(i.children, i.slug);
	}
};
walk(toc?.items as Item[] | undefined);
const hasToggles = flat.some((i) => i.kids > 0);

// ---- Members list, rendered on the server ----
// scripts/genapi.py writes src/data/api-members.json next to api.mdx: { "Category": { "Class": ["Class.member", ...] } }.
// With it, the right-hand column arrives as real HTML instead of being built in the browser after the page loads.
// import.meta.glob (rather than a plain import) so a missing file just means "no manifest", not a build error.
const DIM_PREFIX = false; // show "NumberGroup." dimmed in front of each member (false = plain full names)
type Manifest = Record<string, Record<string, string[]>>;
const manifestFile = Object.values(
	import.meta.glob('../data/api-members.json', { eager: true, import: 'default' }),
)[0] as Manifest | undefined;
const manifest = dynamic && id.startsWith('reference/api') ? manifestFile : undefined;

const textOf = new Map(flat.map((i) => [i.slug, i.text]));
let seenGroup = false;
// One row per heading, in the same order as the headings list: its member ids (if its class has any), or whether it
// gets the small empty gap instead (a gap is only kept once a member list has come before it).
const rows = flat.map((i) => {
	const members = manifest && i.depth === 3 ? manifest[textOf.get(i.parent) ?? '']?.[i.text] : undefined;
	const has = !!members?.length;
	const gap = !has && seenGroup;
	if (has) seenGroup = true;
	return { ...i, members: has ? members : undefined, gap };
});
const groupCount = rows.filter((r) => r.members).length;
// How many heading rows sit above the first class that has members. The members column is pushed down by that many
// rows so its first member starts level with that heading. CSS does it from this number, so it is right on first
// paint instead of after the script has measured (the script still re-measures and overrides it).
const firstGroupRow = rows.findIndex((r) => r.members);
---

{/* Restores the "right sidebar collapsed" state before the page is painted, so it doesn't flash open on load.
    Also marks the page as having JS, so the "hidden until measured" rule below can never leave the TOC hidden without JS. */}
<script is:inline>
	try {
		document.documentElement.setAttribute('data-js', '');
		if (localStorage.getItem('toc-sidebar-collapsed') === '1') document.documentElement.setAttribute('data-toc-collapsed', '');
	} catch (e) {}
</script>

{
	dynamic ? (
		<nav class="api-toc" aria-labelledby="starlight__on-this-page">
			<div class="toc-head">
				<button class="toc-sb-toggle" type="button" aria-label="Toggle table of contents sidebar" title="Toggle sidebar">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<rect x="3" y="4" width="18" height="16" rx="2" />
						<path d="M15 4v16" />
					</svg>
				</button>
				<h2 id="starlight__on-this-page">{Astro.locals.t('tableOfContents.onThisPage')}</h2>
			</div>
			{/* Two lists in a clipped viewport. The script slides them (they are never scrolled natively). */}
			<div class="toc-view">
				<div class="toc-col toc-heads">
					<ul class:list={['toc-list', hasToggles && 'has-toggles']}>
						{rows.map((i) => (
							<li
								data-group={i.slug}
								data-parent={i.parent}
								class:list={[i.kids > 0 && 'has-kids', i.members && 'has-members']}
								style={`--d:${i.depth - 2}`}
							>
								<a href={`#${i.slug}`}>{i.text}</a>
								{i.kids > 0 && (
									<button
										type="button"
										class="toc-toggle"
										aria-expanded="true"
										aria-label={`Collapse or expand ${i.text}`}
									>
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path d="m6 9 6 6 6-6" />
										</svg>
									</button>
								)}
							</li>
						))}
					</ul>
				</div>
				{/* Every class member on the page. Pre-rendered from api-members.json when there is one; otherwise empty
				    and filled in by the script below, which scans the page. */}
				<div
					class="toc-col toc-members"
					hidden={groupCount === 0}
					style={firstGroupRow > 0 ? `--first-rows:${firstGroupRow}` : undefined}
				>
					{rows.map((r) =>
						r.members ? (
							<ul class="members-group" data-group={r.slug}>
								{r.members.map((m) => (
									<li><a href={`#${m}`} title={m}>{DIM_PREFIX && m.startsWith(`${r.text}.`) ? <><span class="pfx">{`${r.text}.`}</span>{m.slice(r.text.length + 1)}</> : m}</a></li>
								))}
							</ul>
						) : r.gap ? (
							<div class="members-gap" data-gap={r.slug} aria-hidden="true"></div>
						) : null,
					)}
				</div>
				{/* The scrollbar's track, rendered here (when there are members) so its width is reserved from the first paint
				    and the sidebar doesn't widen when the script starts. The script sizes it and moves the thumb. */}
				{manifest && groupCount > 0 && (
					<div class="toc-scroll" aria-hidden="true">
						<div class="toc-thumb" />
					</div>
				)}
			</div>
		</nav>
	) : (
		<div class="toc-default">
			<button class="toc-sb-toggle" type="button" aria-label="Toggle table of contents sidebar" title="Toggle sidebar">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<rect x="3" y="4" width="18" height="16" rx="2" />
					<path d="M15 4v16" />
				</svg>
			</button>
			<Default><slot /></Default>
		</div>
	)
}

{/* FIRST-PAINT SIZING. Runs while the page is still being parsed (is:inline = no separate file to download), so the
    scrollbar thumb already has its height when the page is first painted. It does ONE thing: the thumb's height is
    view * view / total, a length divided by a length, which CSS cannot do yet. Everything else (the members list's top
    padding, the gap heights) is plain CSS from --row-h, so it is already right here. The big script below takes over
    afterwards and writes the same numbers, so nothing moves. */}
<script is:inline>
	(function () {
		try {
			if (!matchMedia('(min-width: 72rem)').matches) return;
			var nav = document.querySelector('nav.api-toc');
			if (!nav) return;
			var heads = nav.querySelector('.toc-heads');
			var members = nav.querySelector('.toc-members');
			var track = nav.querySelector('.toc-scroll');
			var thumb = nav.querySelector('.toc-thumb');
			if (!heads || !members || !track || !thumb) return;
			// The track is as tall as the room the sidebar has (--toc-rail). The lists are as tall as their rows.
			var view = track.offsetHeight;
			var total = Math.max(heads.offsetHeight, members.hidden ? 0 : members.offsetHeight);
			if (total > view + 1) {
				thumb.style.height = Math.max(24, (view * view) / total) + 'px';
			} else {
				track.hidden = true; // everything fits: no scrollbar, same as layout() decides
			}
		} catch (e) {}
	})();
</script>

<script>
	const START_COLLAPSED = false; // true = sections with sub-headings (ABC, Core, ...) start collapsed
	const REMEMBER = true; // remember which sections are collapsed, per page, in this browser

	const ANCHOR = 0.35; // how far down the TOC the current row sits (0 = top edge, 1 = bottom edge)
	const TAU = 90; // ms. Smoothing of the slide: smaller = snappier, larger = floatier.
	const TIP_MS = 90; // ms. How long the point of the "{" takes to move to a new row (fast).
	const BRACE_MS = 280; // ms. How long the "{" takes to fade in / fade out / move+resize. Independent of scroll speed.
	// The headings list (left column) is scrolled along a precomputed, as-straight-as-possible path instead of
	// jumping one row per class. The members list (right column) is then slid so the current member is ALWAYS level
	// with the current heading (the ">" and the point of the "{" stay on one line). The price: the row they share is
	// no longer pinned to one screen row, it may wander this far from it:
	const DRIFT = 4; // rows. 0 = pinned (but the headings list moves in bursts), bigger = steadier headings list.
	// The lists glide from one row to the next, so halfway through that glide the pointer is already nearer the NEXT row.
	// The highlight (and the "{") therefore switches to the next row once the page is this far (0..1) towards it,
	// so the highlighted row is always the one the ">" and the point of the "{" are level with, or nearest to.
	// 0.5 = switch halfway. 1 = only when the page has fully reached it (then the pointer can be a whole row ahead).
	const SWITCH = 0.5;
	// The curly line "{" (px):
	const CURVE = 8; // roundness of its top and bottom curves
	const TRAIL = 28; // how far its ends reach to the right before fading out
	const TIP = 8; // how far its middle point sticks out to the left
	const TIP_R = 5; // roundness of that point
	const REVEAL_FONT_WAIT = 400; // ms. Longest the TOC waits for web fonts before it is shown anyway.
	let braceId = 0;

	// Shortest path ("taut string") through a corridor: one value per row i, always between lo[i] and hi[i], the first
	// and last value being fixed (lo = hi there). The path is made of straight pieces and bends only where the corridor
	// forces it to, so it moves at the steadiest speed the corridor allows. Returns one value per row.
	const tautString = (lo: number[], hi: number[]) => {
		const n = lo.length;
		const pts: [number, number][] = [[0, lo[0]]];
		let i0 = 0;
		let y0 = lo[0];
		while (i0 < n - 1) {
			let lowS = -Infinity; // steepest slope forced by a lower bound so far
			let highS = Infinity; // flattest slope allowed by an upper bound so far
			let iL = i0;
			let iH = i0;
			let bent = false;
			for (let j = i0 + 1; j < n; j++) {
				const d = j - i0;
				const sl = (lo[j] - y0) / d;
				const sh = (hi[j] - y0) / d;
				if (sh < lowS) {
					// the corridor closes above: the string has to bend around the lower bound that set lowS
					i0 = iL;
					y0 = lo[iL];
					bent = true;
					break;
				}
				if (sl > highS) {
					// the corridor closes below: bend around the upper bound that set highS
					i0 = iH;
					y0 = hi[iH];
					bent = true;
					break;
				}
				if (sl > lowS) {
					lowS = sl;
					iL = j;
				}
				if (sh < highS) {
					highS = sh;
					iH = j;
				}
			}
			if (!bent) {
				pts.push([n - 1, lo[n - 1]]);
				break;
			}
			pts.push([i0, y0]);
		}
		const out: number[] = new Array(n).fill(0);
		for (let k = 0; k + 1 < pts.length; k++) {
			const [a, ya] = pts[k];
			const [b, yb] = pts[k + 1];
			for (let q = a; q <= b; q++) out[q] = ya + ((yb - ya) * (q - a)) / Math.max(1, b - a);
		}
		return out;
	};

	const init = (nav: HTMLElement) => {
		// The TOC is hidden by CSS until it has been measured and positioned (see ".api-toc:not([data-ready])" below),
		// so it never shows at a wrong size for a moment. Every way out of init must reveal it.
		const ready = () => nav.setAttribute('data-ready', '');

		const viewEl = nav.querySelector<HTMLElement>('.toc-view');
		const heads = nav.querySelector<HTMLElement>('.toc-heads');
		const membersCol = nav.querySelector<HTMLElement>('.toc-members');
		const list = heads?.querySelector('ul');
		if (!viewEl || !heads || !membersCol || !list) {
			ready();
			return;
		}

		const idOf = (a: HTMLAnchorElement) => decodeURIComponent(a.hash.slice(1));

		type Target = { a: HTMLAnchorElement; el: HTMLElement; group: string };
		const all: { a: HTMLAnchorElement; el: HTMLElement | null; group: string }[] = [];

		// 2a. Right list: every member of every class, grouped per class. Normally the server already rendered it
		// (from api-members.json, see the frontmatter): just pick the lists and gaps up. Without a manifest it is empty
		// and built by scanning the page (2b below).
		const groups = new Map<string, HTMLUListElement>(); // class heading id -> its member list
		const gaps = new Map<string, HTMLElement>(); // class heading id -> its gap
		const prebuilt = !!membersCol.querySelector('ul.members-group');
		if (prebuilt) {
			membersCol.querySelectorAll<HTMLUListElement>('ul.members-group').forEach((ul) => groups.set(ul.dataset.group!, ul));
			membersCol.querySelectorAll<HTMLElement>('.members-gap').forEach((g) => gaps.set(g.dataset.gap!, g));
		}

		// 1. Left list: headings (rendered by the server). With a prebuilt members list, each class's members are added
		// right after their heading, which is already the order they have on the page (so no sorting is needed later).
		const headLis = new Map<string, HTMLLIElement>();
		const parentOf = new Map<string, string>(); // heading id -> id of the heading it sits under ('' = top level)
		list.querySelectorAll<HTMLLIElement>('li').forEach((li) => {
			const a = li.querySelector('a')!;
			const slug = li.dataset.group!;
			headLis.set(slug, li);
			parentOf.set(slug, li.dataset.parent ?? '');
			all.push({ a, el: document.getElementById(idOf(a)), group: slug });
			groups.get(slug)?.querySelectorAll('a').forEach((m) => {
				all.push({ a: m, el: document.getElementById(idOf(m)), group: slug });
			});
		});

		if (!prebuilt) {
			// 2b. Fallback (no manifest, e.g. a hand-written page): scan the page for every member and build the lists here.
			const found = document.querySelectorAll<HTMLElement>(
				'.sl-markdown-content :is(h2, h3)[id], .api-member > dt[id]',
			);
			let groupList: HTMLUListElement | undefined;
			let parent = '';
			for (const el of found) {
				// tagName check (not el.matches) so TS doesn't narrow `el` to never in the else branch
				if (el.tagName === 'DT') {
					if (!headLis.has(parent)) continue;
					if (!groupList) {
						groupList = document.createElement('ul');
						groupList.className = 'members-group';
						groups.set(parent, groupList);
						headLis.get(parent)!.classList.add('has-members');
					}
					const li = document.createElement('li');
					const a = document.createElement('a');
					a.href = `#${el.id}`;
					a.title = el.id; // full name on hover, since long ones get cut with "..."
					// e.g. NumberGroup.divide -> dimmed "NumberGroup." + "divide"
					const prefix = `${parent}.`;
					if (el.id.startsWith(prefix)) {
						const dim = document.createElement('span');
						dim.className = 'pfx';
						dim.textContent = prefix;
						a.append(dim, el.id.slice(prefix.length));
					} else {
						a.textContent = el.id;
					}
					li.append(a);
					groupList.append(li);
					all.push({ a, el, group: parent });
				} else if (headLis.has(el.id)) {
					parent = el.id;
					groupList = undefined;
				}
			}
			// Lay the members list out in the same order as the headings list. After the first class that has members,
			// every class WITHOUT members gets a small empty gap (half a row) in its place, so the list keeps pace with
			// the headings and scrolling past such a class moves it a little instead of not at all.
			let seenGroup = false;
			for (const slug of headLis.keys()) {
				const ul = groups.get(slug);
				if (ul) {
					membersCol.append(ul);
					seenGroup = true;
				} else if (seenGroup) {
					const gap = document.createElement('div');
					gap.className = 'members-gap';
					gap.setAttribute('aria-hidden', 'true');
					membersCol.append(gap);
					gaps.set(slug, gap);
				}
			}
		}
		membersCol.hidden = groups.size === 0;

		// The accent line: ONE curly "{" drawn as an SVG and redrawn every frame from the same reading position
		// as the lists, so its middle point and the ">" on the heading are always level and in step.
		const SVG = 'http://www.w3.org/2000/svg';
		const X0 = TIP + 1; // x of the vertical part (the point sticks out to its left)
		const XE = X0 + CURVE + TRAIL; // right end of the trailing curves
		const gradId = `toc-brace-${braceId++}`;
		const line = document.createElementNS(SVG, 'svg');
		line.setAttribute('class', 'toc-line');
		line.setAttribute('aria-hidden', 'true');
		line.setAttribute('width', String(XE + 1));
		line.style.left = `${-TIP}px`;
		const grad = document.createElementNS(SVG, 'linearGradient'); // fades the ends out to the right
		grad.setAttribute('id', gradId);
		grad.setAttribute('gradientUnits', 'userSpaceOnUse');
		grad.setAttribute('x1', String(X0 + CURVE));
		grad.setAttribute('x2', String(XE));
		grad.setAttribute('y1', '0');
		grad.setAttribute('y2', '0');
		for (const [offset, opacity] of [['0', '1'], ['1', '0']]) {
			const stop = document.createElementNS(SVG, 'stop');
			stop.setAttribute('offset', offset);
			stop.setAttribute('style', `stop-color: var(--sl-color-text-accent); stop-opacity: ${opacity}`);
			grad.append(stop);
		}
		const defs = document.createElementNS(SVG, 'defs');
		defs.append(grad);
		const brace = document.createElementNS(SVG, 'path');
		brace.setAttribute('fill', 'none');
		brace.setAttribute('stroke', `url(#${gradId})`);
		brace.setAttribute('stroke-width', '2');
		brace.setAttribute('stroke-linecap', 'round');
		line.append(defs, brace);
		membersCol.append(line);

		// A scrollbar for the whole TOC, on its right edge. The lists are slid by script, never scrolled natively,
		// so this is drawn by hand: the thumb shows how far through the page's rows you are, and can be dragged.
		// Normally the server already rendered it (so its width is reserved from the first paint): reuse that one.
		const serverTrack = viewEl.querySelector<HTMLElement>(':scope > .toc-scroll');
		const track = serverTrack ?? document.createElement('div');
		const thumb = track.querySelector<HTMLElement>('.toc-thumb') ?? document.createElement('div');
		thumb.className = 'toc-thumb';
		if (!thumb.parentElement) track.append(thumb);
		if (!serverTrack) {
			track.className = 'toc-scroll';
			track.setAttribute('aria-hidden', 'true');
			track.hidden = true;
			viewEl.append(track);
		}

		// Every row of the TOC (headings and members), in the order they appear on the page.
		const order = (x: { el: HTMLElement | null }, y: { el: HTMLElement | null }) =>
			x.el && y.el ? (x.el.compareDocumentPosition(y.el) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1) : 0;
		const everything = all.filter((t): t is Target => !!t.el);
		if (!prebuilt) everything.sort(order); // a prebuilt list is already in page order
		if (!everything.length) {
			ready();
			return;
		}

		// The rows currently in play. Rows inside a collapsed section are left out (see "Collapsing" below), so
		// everything that follows (the reading position, the paths, the "{") only ever sees the visible rows.
		let targets: Target[] = everything;
		let n = targets.length;
		let indexOf = new Map(targets.map((t, i) => [t.a, i]));
		// For every row of the page (hidden ones too): the index, in `targets`, of the visible row that stands for it.
		// A row inside a collapsed section is stood for by the section's own heading.
		let vis: number[] = [];

		// Collapsing.
		//   A heading that has sub-headings (ABC, Core, ... and their classes) gets a "v" button. Collapsing it hides
		//   all its sub-headings in the left list AND their member lists in the right list. While the page is inside a
		//   collapsed section, the section's own heading is the current row.
		const kidsSlugs = [...headLis].filter(([, li]) => li.classList.contains('has-kids')).map(([s]) => s);
		const collapsed = new Set<string>(); // headings that are currently collapsed
		const hiddenSlugs = new Set<string>(); // headings hidden because something above them is collapsed
		let visibleGroups = 0; // member lists currently shown
		const KEY = `toc-collapsed:${location.pathname}`;
		try {
			const raw = REMEMBER ? localStorage.getItem(KEY) : null;
			if (raw !== null) {
				for (const s of JSON.parse(raw) as string[]) if (kidsSlugs.includes(s)) collapsed.add(s);
			} else if (START_COLLAPSED) {
				for (const s of kidsSlugs) collapsed.add(s);
			}
		} catch {
			if (START_COLLAPSED) for (const s of kidsSlugs) collapsed.add(s);
		}
		const saveCollapsed = () => {
			if (!REMEMBER) return;
			try {
				localStorage.setItem(KEY, JSON.stringify([...collapsed]));
			} catch {}
		};

		// Applies `collapsed` to the page: hides / shows the rows and rebuilds the list of rows in play.
		const applyCollapse = () => {
			hiddenSlugs.clear();
			// headLis is in document order, so a heading's parent is always decided before the heading itself
			for (const slug of headLis.keys()) {
				const p = parentOf.get(slug);
				if (p && (collapsed.has(p) || hiddenSlugs.has(p))) hiddenSlugs.add(slug);
			}
			let seen = false; // a visible member list has come earlier in the list
			visibleGroups = 0;
			for (const [slug, li] of headLis) {
				const hid = hiddenSlugs.has(slug);
				li.classList.toggle('toc-hidden', hid);
				if (li.classList.contains('has-kids')) {
					const open = !collapsed.has(slug);
					li.classList.toggle('collapsed', !open);
					li.querySelector('.toc-toggle')?.setAttribute('aria-expanded', String(open));
				}
				const ul = groups.get(slug);
				if (ul) {
					ul.classList.toggle('toc-hidden', hid);
					if (!hid) {
						seen = true;
						visibleGroups++;
					}
				} else {
					// A gap is only kept once a visible member list has come before it (same rule as the first build).
					gaps.get(slug)?.classList.toggle('toc-hidden', hid || !seen);
				}
			}
			membersCol.hidden = visibleGroups === 0;
			targets = everything.filter((t) => !hiddenSlugs.has(t.group));
			n = targets.length;
			indexOf = new Map(targets.map((t, i) => [t.a, i]));
			vis = [];
			let k = -1;
			for (const t of everything) {
				if (!hiddenSlugs.has(t.group)) k++;
				vis.push(Math.max(0, k));
			}
		};
		applyCollapse();

		// 3. How it moves (wide screens only; on narrow screens the lists are just stacked).
		//
		//    Reading the page gives ONE continuous number u: "row 41.3" = 30% of the way from row 41 to row 42.
		//
		//    RIGHT list (members): slid so the current member is always level with the current heading.
		//
		//    LEFT list (headings): the old rule slid it one full row per class, whatever the class's size: frozen for a
		//    class with 20 members, then a burst through a run of short classes. Instead, when the layout is measured, the
		//    steadiest path (a "taut string") that keeps the shared row within DRIFT rows of the anchor is computed once,
		//    and the headings list follows it. The members list then follows u as before, offset by whatever the headings
		//    list did, so heading and member stay level.
		//
		//    Both lists are moved in the same frame from the same u, and u itself eases toward the page, so
		//    nothing teleports.
		//
		//    The "{" is different: its fade / move / resize is NOT tied to u. When the current row enters a
		//    different class, the "{" starts a fixed-length (BRACE_MS) animation and always finishes it, however
		//    slowly (or not at all) you keep scrolling. Only its middle point keeps following u.
		const desktop = matchMedia('(min-width: 72rem)');
		const sidebarEl = nav.closest<HTMLElement>('.right-sidebar');
		let live = false; // false while this copy of the TOC is hidden or on a narrow screen
		let view = 0; // visible height of the lists
		let maxL = 0; // how far each list can slide before it runs out
		let maxR = 0;
		let hasMembers = false;
		let LYs: number[] = []; // per row: where its class heading is in the left list
		let RYs: number[] = []; // per row: where it is in the right list
		let BTs: number[] = []; // per row: top / bottom of its class's member list, and whether it has one (1) or not (0)
		let BBs: number[] = [];
		let BSs: number[] = [];
		let OLs: number[] = []; // per row: how far the left list is slid when the page is exactly on that row (smoothed)
		let ORs: number[] = []; // per row: the same for the right list, chosen so the row's heading and member are level
		let rowH = 24.25; // height of one row (measured exactly in layout(); matches --row-h in the CSS)
		let target = 0; // u the page is at
		let cur = 0; // u as currently shown (eased)
		let raf = 0;
		let lastT = 0;
		// Extra px both lists are slid by on top of their paths. Used to keep a heading you just collapsed / expanded
		// exactly where it was on screen (see refresh). It eases back to 0 as soon as the page scrolls.
		let shiftCur = 0;
		let shiftTarget = 0;

		// The "{" as currently shown (top / bottom in members-list coordinates, opacity) and its animation.
		let bTop = 0;
		let bBot = 0;
		let bOp = 0;
		let bFrom = { top: 0, bot: 0, op: 0 };
		let bTo = { top: 0, bot: 0, op: 0 };
		let bStart = 0;
		let bRaf = 0;
		// The point of the "{" (centre of the active row, in members-list coordinates) and its own short animation.
		let tipY = 0;
		let tipFrom = 0;
		let tipTo = 0;
		let tStart = 0;
		let scrollable = false; // the lists are taller than the window, so the scrollbar is shown
		let thumbH = 0; // height of the scrollbar's thumb

		// A cheap fingerprint of everything whose size makes the layout need re-measuring. Used to skip pointless
		// layout() runs (the ResizeObserver fires once straight after observe(), and again after layout's own writes).
		let lastKey = '';
		const sizeKey = () =>
			`${heads.offsetWidth}x${heads.offsetHeight}|${membersCol.offsetWidth}x${membersCol.offsetHeight}|${sidebarEl?.clientHeight ?? 0}`;

		const clamp = (v: number, max: number) => Math.max(0, Math.min(max, v));
		const snap = (v: number) => Math.round(v * (devicePixelRatio || 1)) / (devicePixelRatio || 1); // sharp text
		// Natural (un-slid) top of an element inside its list.
		const topIn = (el: HTMLElement, col: HTMLElement) => el.getBoundingClientRect().top - col.getBoundingClientRect().top;
		const at = (arr: number[], u: number) => {
			const i = Math.min(Math.floor(u), n - 1);
			return i >= n - 1 ? arr[n - 1] : arr[i] + (arr[i + 1] - arr[i]) * (u - i);
		};
		const idxOf = (u: number) => Math.min(n - 1, Math.max(0, Math.floor(u + 1 - SWITCH + 1e-6)));

		// Where both lists would be slid at reading position u if the current heading and the current member shared
		// one screen row (the old behaviour). The right list always uses this. The left list uses it only to know
		// where its corridor is (see smoothLeft) and when there are no members at all.
		const offsets = (u: number) => {
			const LY = at(LYs, u);
			const RY = at(RYs, u);
			const A = view * ANCHOR; // screen row the current entry sits on
			if (!hasMembers) return { offL: clamp(LY - A, maxL), offR: 0 };
			// Keep both lists on screen near the very top / bottom by moving the shared row, never by misaligning.
			const hi = Math.min(LY, RY);
			const lo = Math.max(LY - maxL, RY - maxR);
			const row = lo <= hi ? Math.min(Math.max(A, lo), hi) : A;
			return { offL: clamp(LY - row, maxL), offR: clamp(RY - row, maxR) };
		};

		// Builds OLs: the steady path of the headings list (see "LEFT list" above). Called whenever sizes are measured.
		const smoothLeft = () => {
			OLs = [];
			ORs = [];
			if (!hasMembers || n < 3) return;
			const A = view * ANCHOR;
			const yLo = Math.max(rowH, A - DRIFT * rowH); // highest / lowest screen y the shared row may have
			const yHi = Math.min(view - 2 * rowH, A + DRIFT * rowH);
			const old: number[] = [];
			const lo: number[] = [];
			const hi: number[] = [];
			for (let i = 0; i < n; i++) {
				const v = offsets(i).offL;
				old.push(v);
				// heading y on screen = LY - offL. Also the members list must not run out (0 <= RY - LY + offL <= maxR),
				// or the two could no longer be kept level.
				const l = Math.max(0, LYs[i] - yHi, LYs[i] - RYs[i]);
				const h = Math.min(maxL, LYs[i] - yLo, maxR + LYs[i] - RYs[i]);
				lo.push(Math.min(l, v)); // the old position is always allowed, so the corridor is never empty
				hi.push(Math.max(h, v));
			}
			// Start and end stay exactly where they were: top of the page = top of the list, bottom = bottom.
			lo[0] = hi[0] = old[0];
			lo[n - 1] = hi[n - 1] = old[n - 1];
			// Work with the shared screen row s = LY - offL (the row the heading AND its member sit on). Neither list may
			// ever slide backwards while you scroll down: that means s may grow by at most min(heading step, member step)
			// from one row to the next. Subtract that allowance (m) and the rule becomes "q never goes up", which is
			// enforced by tightening the corridor (running min of the upper edge, running max of the lower edge).
			const m: number[] = [0];
			for (let i = 1; i < n; i++) m.push(m[i - 1] + Math.max(0, Math.min(LYs[i] - LYs[i - 1], RYs[i] - RYs[i - 1])));
			const qLo = lo.map((_, i) => LYs[i] - hi[i] - m[i]);
			const qHi = lo.map((_, i) => LYs[i] - lo[i] - m[i]);
			for (let i = 1; i < n; i++) qHi[i] = Math.min(qHi[i], qHi[i - 1]);
			for (let i = n - 2; i >= 0; i--) qLo[i] = Math.max(qLo[i], qLo[i + 1]);
			for (let i = 0; i < n; i++) qLo[i] = Math.min(qLo[i], qHi[i]);
			const q = tautString(qLo, qHi);
			OLs = q.map((v, i) => clamp(LYs[i] - (v + m[i]), maxL));
			// Right list, per row: slid so that row's member is level with its heading. Between rows it is interpolated
			// row by row, exactly like before (NOT recomputed from the headings' stepwise position, which made it jump).
			ORs = OLs.map((v, i) => clamp(RYs[i] - LYs[i] + v, maxR));
			ORs[0] = offsets(0).offR;
			ORs[n - 1] = offsets(n - 1).offR;
		};

		// Redraw the "{" over [top, bottom] of the members list, its point at tipY. Its point keeps its full length
		// and only moves up and down, so it is already "there" when the rest fades in.
		const drawLine = (top: number, bottom: number, tipY: number, opacity: number) => {
			const t = snap(top);
			const H = Math.round(snap(bottom) - t);
			if (opacity < 0.02 || H < 8) {
				line.style.opacity = '0';
				return;
			}
			const R = Math.min(CURVE, (H - 2) / 2);
			const r = Math.min(TIP_R, Math.max(0, (H - 2 - 2 * R) / 2));
			const lo = 1 + R + r;
			const hi = H - 1 - R - r;
			const yt = Math.round(lo <= hi ? Math.min(Math.max(tipY - t, lo), hi) : H / 2);
			line.style.opacity = String(opacity);
			line.style.transform = `translateY(${t}px)`;
			line.setAttribute('height', String(H));
			brace.setAttribute(
				'd',
				`M ${XE} 1 H ${X0 + R} A ${R} ${R} 0 0 0 ${X0} ${1 + R} V ${yt - r} Q ${X0} ${yt} 1 ${yt} Q ${X0} ${yt} ${X0} ${yt + r} V ${H - 1 - R} A ${R} ${R} 0 0 0 ${X0 + R} ${H - 1} H ${XE}`,
			);
		};

		const render = () => {
			if (!live) {
				heads.style.transform = membersCol.style.transform = '';
				line.style.opacity = '0';
				track.hidden = true;
				return;
			}
			const u = clamp(cur, n - 1);
			const o = offsets(u);
			// Right list: current member on the anchor row. Left list: the steady path (or, with no members, the old rule).
			const smooth = hasMembers && OLs.length === n && ORs.length === n;
			const offL = clamp((smooth ? at(OLs, u) : o.offL) + shiftCur, maxL);
			// Smooth: both lists follow their own per-row paths, level with each other on every row.
			const offR = clamp((smooth ? at(ORs, u) : o.offR) + shiftCur, maxR);
			heads.style.transform = `translateY(${-snap(offL)}px)`;
			membersCol.style.transform = `translateY(${-snap(offR)}px)`;
			// The "{" box (top / bottom / opacity) and its point each come from their own timed animation,
			// not from the scroll position (drawLine keeps the point inside the "{").
			drawLine(bTop, bBot, tipY, bOp);
			if (scrollable) thumb.style.transform = `translateY(${snap((n > 1 ? u / (n - 1) : 0) * (view - thumbH))}px)`;
		};

		const braceTick = (t: number) => {
			const p = Math.min(1, Math.max(0, (t - bStart) / BRACE_MS));
			const e = 1 - Math.pow(1 - p, 3); // ease-out
			bTop = bFrom.top + (bTo.top - bFrom.top) * e;
			bBot = bFrom.bot + (bTo.bot - bFrom.bot) * e;
			bOp = bFrom.op + (bTo.op - bFrom.op) * e;
			const q = Math.min(1, Math.max(0, (t - tStart) / TIP_MS));
			tipY = tipFrom + (tipTo - tipFrom) * (1 - Math.pow(1 - q, 3));
			render();
			bRaf = p < 1 || q < 1 ? requestAnimationFrame(braceTick) : 0;
		};

		// Move the point of the "{" to the centre of row idx's line: a short, fixed-length animation that runs
		// once when the row changes, whatever the scroll speed.
		const setTip = (idx: number, instant = false) => {
			if (RYs[idx] === undefined) return;
			const y = RYs[idx] + rowH / 2;
			if (instant) {
				tipY = tipFrom = tipTo = y;
				return;
			}
			if (y === tipTo) return;
			tipFrom = tipY;
			tipTo = y;
			tStart = performance.now();
			if (!bRaf) bRaf = requestAnimationFrame(braceTick);
		};

		// Point the "{" at the class that row idx belongs to.
		//   class with members -> class with members: it moves and resizes from one to the other (tween)
		//   no members -> class with members: it fades in, already at the new class's size and place
		//   class with members -> no members: it fades out where it is
		// Called only when the row changes; the animation then runs for BRACE_MS regardless of scrolling.
		const setBrace = (idx: number, instant = false) => {
			const has = BSs[idx] === 1;
			const to = has
				? { top: BTs[idx], bot: BBs[idx], op: 1 }
				: { top: bTo.top, bot: bTo.bot, op: 0 };
			if (!instant && to.top === bTo.top && to.bot === bTo.bot && to.op === bTo.op) return;
			// Appearing from nothing: put the box in place straight away, only the opacity animates.
			if (instant || (has && bOp < 0.02)) {
				bTop = to.top;
				bBot = to.bot;
			}
			if (instant) {
				bOp = to.op;
				bFrom = bTo = to;
				if (bRaf) {
					cancelAnimationFrame(bRaf);
					bRaf = 0;
				}
				return;
			}
			bFrom = { top: bTop, bot: bBot, op: bOp };
			bTo = to;
			bStart = performance.now();
			if (!bRaf) bRaf = requestAnimationFrame(braceTick);
		};

		const tick = (t: number) => {
			raf = 0;
			const dt = Math.min(64, t - lastT || 16);
			lastT = t;
			const k = 1 - Math.exp(-dt / TAU);
			let more = false;
			const diff = target - cur;
			if (Math.abs(diff) < 0.002) {
				cur = target;
			} else {
				cur += diff * k;
				more = true;
			}
			const sd = shiftTarget - shiftCur;
			if (Math.abs(sd) < 0.25) {
				shiftCur = shiftTarget;
			} else {
				shiftCur += sd * k;
				more = true;
			}
			if (more) raf = requestAnimationFrame(tick);
			render();
		};
		const go = (u: number) => {
			target = clamp(u, n - 1);
			if (!live || raf) return;
			lastT = performance.now();
			raf = requestAnimationFrame(tick);
		};

		// Dragging the thumb (or pressing on the track) browses the TOC like the wheel does.
		let grab = 0;
		const dragTo = (e: PointerEvent) =>
			go(clamp((e.clientY - track.getBoundingClientRect().top - grab) / Math.max(1, view - thumbH), 1) * (n - 1));
		track.addEventListener('pointerdown', (e) => {
			if (!live || !scrollable) return;
			e.preventDefault();
			track.setPointerCapture(e.pointerId);
			grab = e.target === thumb ? e.clientY - thumb.getBoundingClientRect().top : thumbH / 2;
			track.classList.add('dragging');
			dragTo(e);
		});
		track.addEventListener('pointermove', (e) => {
			if (track.hasPointerCapture(e.pointerId)) dragTo(e);
		});
		const endDrag = () => track.classList.remove('dragging');
		track.addEventListener('pointerup', endDrag);
		track.addEventListener('pointercancel', endDrag);

		// The width the TOC would have with every section open and the scrollbar showing. The TOC is centred in its
		// column, so if its width followed the collapsed state it would shift sideways on every collapse / expand.
		// Instead the view is never narrower than this. Measured by briefly undoing the collapse (nothing is painted
		// in between) and put back straight away.
		const fullWidth = () => {
			const hiddenEls = [...nav.querySelectorAll<HTMLElement>('.toc-hidden')];
			const wasHidden = membersCol.hidden;
			const trackWasHidden = track.hidden;
			viewEl.style.minWidth = '';
			for (const el of hiddenEls) el.classList.remove('toc-hidden');
			membersCol.hidden = groups.size === 0;
			track.hidden = false;
			const w = viewEl.getBoundingClientRect().width;
			track.hidden = trackWasHidden;
			membersCol.hidden = wasHidden;
			for (const el of hiddenEls) el.classList.add('toc-hidden');
			return w;
		};

		const layout = () => {
			live = false;
			viewEl.style.minWidth = '';
			if (desktop.matches) {
				viewEl.style.minWidth = `${Math.ceil(fullWidth())}px`;
				// Exact (fractional) row height, same value as --row-h in the CSS. offsetHeight would round 24.25 to 24.
				rowH = heads.querySelector('a')?.getBoundingClientRect().height || 24.25;
				membersCol.style.setProperty('--row', `${rowH}px`); // sizes the gaps for classes without members
				// Empty space on top of the members list, as tall as the headings above the first VISIBLE class that has
				// members (Overview, ABC, ...). That class's members then start level with its heading, and the
				// headings above it don't have to scroll away just to make the two lists line up.
				const firstSlug = [...groups.keys()].find((s) => !hiddenSlugs.has(s));
				const firstHead = firstSlug ? headLis.get(firstSlug)!.querySelector('a') : null;
				const firstLink = firstSlug ? groups.get(firstSlug)!.querySelector('a') : null;
				membersCol.style.paddingTop = '0px'; // measure the first member's natural top with no padding...
				membersCol.style.paddingTop =
					firstHead && firstLink ? `${Math.max(0, topIn(firstHead, heads) - topIn(firstLink, membersCol))}px` : '';

				const hL = heads.offsetHeight;
				const hR = membersCol.hidden ? 0 : membersCol.offsetHeight;
				if (hL || hR) {
					// Room left in Starlight's own scroll container (.right-sidebar, fixed, 100vh high): its height,
					// minus where the lists start inside it (padding, "On this page" heading), minus the panel's bottom padding.
					const sidebar = viewEl.closest<HTMLElement>('.right-sidebar');
					const panel = viewEl.closest<HTMLElement>('.right-sidebar-panel');
					const start = viewEl.getBoundingClientRect().top - (sidebar?.getBoundingClientRect().top ?? 0) + (sidebar?.scrollTop ?? 0);
					const padBottom = panel ? parseFloat(getComputedStyle(panel).paddingBottom) || 0 : 0;
					const maxH = (sidebar?.clientHeight ?? innerHeight) - start - padBottom;
					view = Math.min(maxH, Math.max(hL, hR));
					maxL = Math.max(0, hL - view);
					maxR = Math.max(0, hR - view);
					hasMembers = visibleGroups > 0;
					viewEl.style.height = `${view}px`;
					const total = Math.max(hL, hR);
					scrollable = total > view + 1;
					thumbH = scrollable ? Math.max(24, (view * view) / total) : 0;
					track.hidden = !scrollable;
					track.style.height = `${view}px`;
					thumb.style.height = `${thumbH}px`;

					// Per-row positions in both lists.
					const headY = new Map<string, number>();
					for (const [slug, li] of headLis) headY.set(slug, topIn(li.querySelector('a')!, heads));
					const groupTop = new Map<string, number>();
					// A class heading lines up with its first member's row (not the top of the padded group box).
					for (const [slug, ul] of groups) groupTop.set(slug, topIn(ul.querySelector('a')!, membersCol));
					const boxOf = new Map<string, { top: number; bottom: number }>(); // each class's member list
					for (const [slug, ul] of groups) {
						const top = topIn(ul, membersCol);
						boxOf.set(slug, { top, bottom: top + ul.offsetHeight });
					}
					LYs = [];
					RYs = [];
					BTs = [];
					BBs = [];
					BSs = [];
					for (const t of targets) {
						const ly = headY.get(t.group)!;
						LYs.push(ly);
						const gap = gaps.get(t.group);
						let r: number;
						if (membersCol.contains(t.a)) r = topIn(t.a, membersCol);
						else if (groupTop.has(t.group)) r = groupTop.get(t.group)!;
						else if (gap && !gap.classList.contains('toc-hidden')) r = topIn(gap, membersCol); // a class without members: its little gap
						else r = ly; // before the first class with members: level with itself, in the empty space on top
						RYs.push(r);
						const b = boxOf.get(t.group);
						BTs.push(b ? b.top : r);
						BBs.push(b ? b.bottom : r);
						BSs.push(b ? 1 : 0);
					}
					smoothLeft(); // the headings list's steady path, from the measurements above
					live = true;
				}
			}
			if (!live) {
				scrollable = false;
				OLs = [];
				ORs = [];
				track.hidden = true;
				viewEl.style.height = '';
				membersCol.style.paddingTop = '';
			} else {
				// Sizes may have changed: put the "{" straight onto the current class's measurements (no animation).
				setBrace(Math.max(0, active), true);
				setTip(Math.max(0, active), true);
			}
			lastKey = sizeKey(); // remember what was measured, so a ResizeObserver echo of our own writes is skipped
			render();
		};

		// The page's reading position as a continuous row number.
		// Reading line = exactly where the browser puts a jump-link target (the page's scroll-padding-top), so a row
		// you jump to is at the line, not a few pixels below it. The 1px absorbs sub-pixel rounding of the scroll.
		const getOffset = () => (parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0) + 1;

		// Positions of every row of the page, measured ONCE (in document coordinates) and reused on every scroll
		// frame. Before, each frame forced a style recalculation (getComputedStyle) and ~12 getBoundingClientRect
		// calls. Now a scroll frame reads only scrollY. `dirty` is set whenever the page's layout may have changed
		// (its size changes, the window resizes, the breakpoint flips); the next read re-measures.
		let rowTops: number[] = [];
		let readLine = 0;
		let docH = 0;
		let dirty = true;
		const measurePositions = () => {
			const sy = scrollY;
			rowTops = everything.map((t) => t.el.getBoundingClientRect().top + sy);
			readLine = getOffset();
			docH = document.documentElement.scrollHeight;
			dirty = false;
		};

		// Positions are measured on EVERY row of the page, including rows hidden by a collapsed section, so a collapsed
		// section still takes up its real stretch of the page. The result is then mapped onto the visible rows (vis):
		// inside a collapsed section u stays on that section's heading, and only moves on to the next visible heading
		// over the same last stretch it would cover if the section were open.
		const pageU = () => {
			if (dirty) measurePositions();
			const sy = scrollY;
			const topOf = (i: number) => rowTops[i] - sy;
			const N = everything.length;
			let r = readLine;
			// Near the page bottom the last rows can never reach the reading line, so ease the line down
			// over the last screenful until the final row is reached. Keeps u continuous all the way to the end.
			const maxScroll = docH - innerHeight;
			const lastAtBottom = topOf(N - 1) - (maxScroll - sy);
			if (lastAtBottom > r) r += (lastAtBottom - r) * Math.min(1, Math.max(0, (sy - (maxScroll - innerHeight)) / innerHeight));
			// Last row at or above the reading line (rows are in page order, so this is a binary search).
			let lo = 0;
			let hi = N - 1;
			let i = -1;
			while (lo <= hi) {
				const mid = (lo + hi) >> 1;
				if (topOf(mid) <= r) {
					i = mid;
					lo = mid + 1;
				} else hi = mid - 1;
			}
			if (i < 0) return 0;
			if (i >= N - 1) return vis[N - 1];
			const a = topOf(i);
			const b = topOf(i + 1);
			const frac = b > a ? Math.min(1, Math.max(0, (r - a) / (b - a))) : 0;
			return vis[i] + (vis[i + 1] - vis[i]) * frac;
		};

		// Highlight: the last row the page has reached, and its class. In a class's intro (before its first member)
		// that is the class itself; once a member's block reaches the reading line, it becomes that member.
		let active = -1;
		const highlight = (u: number) => {
			const idx = idxOf(u);
			if (idx === active) return;
			if (active >= 0) targets[active]?.a.removeAttribute('aria-current');
			active = idx;
			const now = targets[idx];
			now.a.setAttribute('aria-current', 'true');
			for (const [slug, li] of headLis) li.classList.toggle('active-group', slug === now.group);
			// Headings above the current one (e.g. "Extensions" while on "Cog") get the same soft grey as the members.
			const above = new Set<string>();
			for (let p = parentOf.get(now.group); p; p = parentOf.get(p)) above.add(p);
			for (const [slug, li] of headLis) li.classList.toggle('active-ancestor', above.has(slug));
			for (const [slug, ul] of groups) ul.classList.toggle('active-group', slug === now.group);
		};

		let first = true;
		const update = () => {
			const u = pageU();
			highlight(u);
			if (first) {
				first = false;
				cur = target = u;
				if (live) {
					setBrace(idxOf(u), true);
					setTip(idxOf(u), true);
				}
				render();
			} else {
				// The "{" belongs to the row the PAGE is on. Browsing the TOC with the wheel only slides the lists;
				// the "{" slides with its class and does not move to another one.
				if (live) {
					setBrace(active);
					setTip(active);
				}
				shiftTarget = 0; // the page moved: stop holding a toggled heading in place and follow the page again
				go(u);
			}
		};

		// A section was collapsed or expanded: rebuild the rows in play, re-measure, and redraw straight away.
		//   `pin` = the heading that was clicked and the screen y (inside the view) it was at. After the lists are
		//   rebuilt they are slid so that heading is back at exactly that y, instead of following the page's
		//   reading position (which could be far away, e.g. near the bottom, and would fling the TOC there).
		//   The TOC follows the page again as soon as the page scrolls.
		const refresh = (pin?: { a: HTMLAnchorElement; y: number }) => {
			applyCollapse();
			nav.querySelectorAll('[aria-current]').forEach((el) => el.removeAttribute('aria-current'));
			active = -1;
			first = true;
			shiftCur = shiftTarget = 0;
			layout();
			update();
			const h = pin ? indexOf.get(pin.a) : undefined;
			if (pin && live && h !== undefined) {
				const smooth = hasMembers && OLs.length === n && ORs.length === n;
				const baseL = smooth ? at(OLs, h) : offsets(h).offL;
				cur = target = h;
				// the heading's y on screen is LYs[h] - (baseL + shift): solve for the shift that puts it at pin.y
				shiftCur = shiftTarget = LYs[h] - pin.y - baseL;
				render();
			}
		};

		// Clicking a "v" button collapses / expands that heading's section.
		list.addEventListener('click', (e) => {
			const btn = (e.target as Element).closest<HTMLElement>('.toc-toggle');
			const li = btn?.closest<HTMLElement>('li');
			const slug = li?.dataset.group;
			const a = li?.querySelector('a');
			if (!btn || !li || !slug || !a) return;
			e.preventDefault();
			const y = a.getBoundingClientRect().top - viewEl.getBoundingClientRect().top; // where it is now
			if (collapsed.has(slug)) collapsed.delete(slug);
			else collapsed.add(slug);
			saveCollapsed();
			refresh({ a, y });
		});

		// Wheel over the TOC: browse it by hand (it glides row by row). It snaps back to following the page
		// as soon as the page scrolls again. The wheel never leaks to the page while the cursor is over the TOC.
		viewEl.addEventListener(
			'wheel',
			(e) => {
				if (!live || e.ctrlKey) return;
				const d = (e.deltaY * (e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? view : 1)) / rowH;
				e.preventDefault(); // always keep the wheel inside the TOC, even at its ends
				go(target + d);
			},
			{ passive: false },
		);
		// Keyboard focus on a link: glide to it. Not for mouse clicks: focus happens on mouse DOWN, and gliding then
		// slides the link out from under the cursor before mouse UP, so the browser never sees a click on it.
		viewEl.addEventListener('focusin', (e) => {
			if (!(e.target as Element).matches(':focus-visible')) return;
			const a = (e.target as Element).closest('a');
			const i = a ? indexOf.get(a) : undefined;
			if (i !== undefined) go(i);
		});

		let ticking = false;
		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				ticking = false;
				update();
			});
		};

		// Re-measure the TOC at most once per frame, and only if something it depends on actually changed size.
		// (layout() is expensive: it forces several reflows. It used to run on every ResizeObserver callback, including
		// the one that fires straight after observe() and the echoes of its own style writes.)
		let layoutQueued = false;
		let forceNext = false;
		const queueLayout = (force = false) => {
			forceNext ||= force;
			if (layoutQueued) return;
			layoutQueued = true;
			requestAnimationFrame(() => {
				layoutQueued = false;
				const f = forceNext;
				forceNext = false;
				if (!f && sizeKey() === lastKey) return;
				layout();
				onScroll();
			});
		};

		addEventListener('scroll', onScroll, { passive: true });
		addEventListener('resize', () => {
			dirty = true;
			queueLayout(true);
		});
		desktop.addEventListener('change', () => {
			dirty = true;
			queueLayout(true);
		});
		// Lists change size when fonts load or the panel is resized: just re-measure.
		const ro = new ResizeObserver(() => queueLayout());
		ro.observe(heads);
		ro.observe(membersCol);
		// The sidebar changes size when it is collapsed into a floating card (and back): re-measure then too.
		if (sidebarEl) ro.observe(sidebarEl);

		// The page's own rows move when the page changes size (code tabs, fonts, images, the left sidebar collapsing...):
		// throw the cached positions away and re-read the reading position.
		const pageRo = new ResizeObserver(() => {
			dirty = true;
			onScroll();
		});
		pageRo.observe(document.documentElement);
		const pageContent = document.querySelector('.sl-markdown-content');
		if (pageContent) pageRo.observe(pageContent);

		// Width of the visible right-hand column (it changes with the window and when the left sidebar collapses).
		const container = nav.closest<HTMLElement>('.right-sidebar-container');
		const panel = nav.closest<HTMLElement>('.right-sidebar-panel');
		const fitCol = () => {
			// minus the 1px border on the column's left edge
			if (container && panel) panel.style.setProperty('--toc-col', `${Math.max(0, container.getBoundingClientRect().width - 1)}px`);
		};
		if (container) new ResizeObserver(fitCol).observe(container);
		fitCol();

		layout();
		update();

		// Reveal once measured. Wait briefly for web fonts (they change text widths, so measuring before they load
		// would show a second jump), but never longer than REVEAL_FONT_WAIT.
		const fonts = document.fonts?.ready ?? Promise.resolve();
		Promise.race([fonts, new Promise((r) => setTimeout(r, REVEAL_FONT_WAIT))]).then(() => {
			if (sizeKey() !== lastKey) {
				layout();
				update();
			}
			requestAnimationFrame(ready);
		});
	};

	document.querySelectorAll<HTMLElement>('nav.api-toc').forEach((nav) => {
		try {
			init(nav);
		} catch (err) {
			console.error(err);
			nav.setAttribute('data-ready', ''); // never leave the TOC hidden if something goes wrong
		}
	});

	// Collapsing the whole right sidebar. Same idea as the left sidebar (see Sidebar.astro):
	//   - the button next to "On this page" collapses it (or, when collapsed / peeking, pins it open again)
	//   - collapsed: it hides at the right edge of the window; moving the mouse to that edge makes it peek
	//     out as a floating card, and moving away from the card closes it again.
	{
		const root = document.documentElement;
		const wide = matchMedia('(min-width: 72rem)'); // the right sidebar only exists at this width
		const EDGE = 6; // px from the right edge of the window that triggers the peek
		const CLOSE_DELAY = 150; // ms before the peeking card slides away
		const KEY = 'toc-sidebar-collapsed';
		const pane = () => document.querySelector<HTMLElement>('.right-sidebar');

		// Width of the visible right-hand column, for centring Starlight's own TOC on regular pages
		// (the two-column TOC on API pages no longer needs it).
		const column = document.querySelector<HTMLElement>('.right-sidebar-container');
		const colPanel = column?.querySelector<HTMLElement>('.right-sidebar-panel');
		if (column && colPanel) {
			const fit = () => colPanel.style.setProperty('--toc-col', `${Math.max(0, column.getBoundingClientRect().width - 1)}px`);
			new ResizeObserver(fit).observe(column);
			fit();
		}

		let closeTimer = 0;
		const cancelClose = () => {
			clearTimeout(closeTimer);
			closeTimer = 0;
		};
		const peek = (on: boolean) => {
			cancelClose();
			root.toggleAttribute('data-toc-peek', on);
		};
		const scheduleClose = () => {
			if (closeTimer) return; // already counting down
			closeTimer = window.setTimeout(() => {
				closeTimer = 0;
				peek(false);
			}, CLOSE_DELAY);
		};

		document.addEventListener('click', (event) => {
			if (!(event.target as Element).closest('.toc-sb-toggle')) return;
			if (root.hasAttribute('data-toc-collapsed')) root.removeAttribute('data-toc-collapsed');
			else root.setAttribute('data-toc-collapsed', '');
			peek(false);
			try {
				localStorage.setItem(KEY, root.hasAttribute('data-toc-collapsed') ? '1' : '0');
			} catch {}
		});

		document.addEventListener('mousemove', (event) => {
			if (!wide.matches || !root.hasAttribute('data-toc-collapsed')) return;
			// clientWidth excludes the page's own scrollbar, so the edge is the strip just left of it
			if (event.clientX >= root.clientWidth - EDGE) {
				peek(true);
			} else if (root.hasAttribute('data-toc-peek')) {
				const r = pane()?.getBoundingClientRect();
				const inside =
					!!r && event.clientX >= r.left && event.clientX <= r.right && event.clientY >= r.top && event.clientY <= r.bottom;
				if (inside) cancelClose();
				else scheduleClose();
			}
		});
		// Mouse left the window entirely.
		document.addEventListener('mouseleave', () => {
			if (root.hasAttribute('data-toc-peek')) scheduleClose();
		});
	}
</script>

<style is:global>
	/* Jump links (e.g. #Button.to_json) put their target this far below the top bar. Starlight adds 1.5rem here,
	   which left a strip of the previous section showing above the target. 0 = the target sits flush at the top.
	   The TOC's reading line is read from this same value, so jumping and highlighting always agree. */
	html:root:has(.api-toc) {
		--toc-jump-gap: 0rem;
		scroll-padding-top: calc(var(--toc-jump-gap) + var(--sl-nav-height) + var(--sl-mobile-toc-height));
	}
	@media (min-width: 72em) {
		html:root:has(.api-toc) {
			scroll-padding-top: calc(var(--toc-jump-gap) + var(--sl-nav-height));
		}
	}

	/* ONE row of the TOC, written down once: line-height 1.25 x font size, plus 0.25rem padding above and below
	   (see ".api-toc a" below). The members list's top padding and the gap heights are calculated from it, so they
	   are exact on first paint. (An "em" there would have used the container's 16px instead of the link's font size.) */
	.api-toc {
		--row-h: calc(1.25 * var(--sl-text-xs) + 0.5rem);
	}

	/* Matches Starlight's TableOfContentsList. Font size, link colour, hover colour and the
	   h2 heading style are inherited from Starlight's .right-sidebar-panel rules. */
	.api-toc ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
