	/* The section(s) the current row sits in (e.g. "Extensions" while on "Cog"): same soft grey as the current
	   class's members. gray-1 is brighter, gray-2 softer (keep this in step with .members-group.active-group below). */
	.api-toc li.active-ancestor > a:not([aria-current='true']) {
