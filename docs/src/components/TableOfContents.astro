			max-width: 100%;
		}
		.right-sidebar-panel .sl-container:has(.api-toc) {
			width: auto;
		}
		/* Starlight's .right-sidebar is position: fixed with width: 100%, which is the width of the WINDOW, not of
		   the column: most of it is off-screen to the right. So the panel is sized to the part that is actually
		   visible (the column's width, kept in --toc-col by the script), and the TOC is centred inside that. */
		.right-sidebar-panel:has(.api-toc) {
			width: max-content; /* as wide as the TOC itself; the sidebar is pinned to the right edge (see the end of this file) */
		}

		/* Align the whole TOC (heading + lists) to the right edge of the visible right-hand column (panel width: see
		   above). If it is wider than the column it just fills it. */
		.api-toc {
			width: fit-content;
			max-width: 100%;
			margin-inline: auto 0;
		}

		.api-toc {
			--toc-member-max: 14rem; /* members longer than this are cut with "..." (full name on hover) */
			--toc-max: calc(100vh - var(--sl-nav-height) - 1rem); /* Starlight's right sidebar height minus the panel's top padding. A limit until the script fits the lists exactly. */
			/* Height of the scrollbar's track before the script has measured the real one: the sidebar's height minus the
			   panel's top padding (1rem), the "On this page" row (1.9rem) and its margin (0.5rem). The script overrides it. */
			--toc-rail: calc(100vh - var(--sl-nav-height) - 3.4rem);
		}

		/* A clipped window onto the two lists; the script slides the lists inside it. */
		.api-toc .toc-view {
			display: flex;
			align-items: flex-start;
