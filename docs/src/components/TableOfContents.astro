---
import Default from '@astrojs/starlight/components/TableOfContents.astro';

const { id, toc } = Astro.locals.starlightRoute;

// Only the API reference page gets the two-column TOC (everything else uses Starlight's default). Its members
// list is rendered on the server from src/data/api-members.json: { "Group": { "Class": ["Class.member", ...] } }.
// import.meta.glob so a missing file means "no manifest" (default TOC), not a build error.
type Manifest = Record<string, Record<string, string[]>>;
const manifestFile = Object.values(
	import.meta.glob('../data/api-members.json', { eager: true, import: 'default' }),
)[0] as Manifest | undefined;
const manifest = !!toc && id === 'reference/api' ? manifestFile : undefined;
const dynamic = !!manifest;

type Item = { slug: string; text: string; depth: number; children: Item[] };
type Flat = { slug: string; text: string; depth: number; parent: string; kids: number };
const flat: Flat[] = [];
const walk = (items: Item[] = [], parent = '') => {
	for (const i of items) {
		flat.push({ slug: i.slug, text: i.text, depth: i.depth, parent, kids: i.children.length });
		walk(i.children, i.slug);
	}
};
walk(toc?.items as Item[] | undefined);

const textOf = new Map(flat.map((i) => [i.slug, i.text]));
let seenGroup = false;
// One row per heading: its member ids (if its class has any), or a small gap (kept only after a member list).
const rows = flat.map((i) => {
	const members = manifest?.[textOf.get(i.parent) ?? '']?.[i.text];
	const has = !!members?.length;
	const gap = !has && seenGroup;
	if (has) seenGroup = true;
	return { ...i, members: has ? members : undefined, gap };
});
const groupCount = rows.filter((r) => r.members).length;
// Heading rows above the first class with members: CSS pads the members column by this many rows (--first-rows).
const firstGroupRow = rows.findIndex((r) => r.members);
---

{/* Restore the "right sidebar collapsed" state before first paint so it doesn't flash open. */}
<script is:inline>
	try {
		if (localStorage.getItem('toc-sidebar-collapsed') === '1') document.documentElement.setAttribute('data-toc-collapsed', '');
	} catch (e) {}
</script>

{
	dynamic ? (
		<nav class="api-toc" aria-labelledby="starlight__on-this-page">
			<div class="toc-head">
				<button class="toc-sb-toggle" type="button" aria-label="Toggle table of contents sidebar" title="Toggle sidebar">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<rect x="3" y="4" width="18" height="16" rx="2" />
						<path d="M15 4v16" />
					</svg>
				</button>
				<h2 id="starlight__on-this-page">{Astro.locals.t('tableOfContents.onThisPage')}</h2>
			</div>
			{/* Two lists in a clipped viewport. The script slides them (never scrolled natively). */}
			<div class="toc-view">
				<div class="toc-col toc-heads">
					<ul>
						{rows.map((i) => (
							<li
								data-group={i.slug}
								data-parent={i.parent}
								class:list={[i.kids > 0 && 'has-kids', i.members && 'has-members']}
								style={`--d:${i.depth - 2}`}
							>
								<a href={`#${i.slug}`}>{i.text}</a>
								{i.kids > 0 && (
									<button
										type="button"
										class="toc-toggle"
										aria-expanded="true"
										aria-label={`Collapse or expand ${i.text}`}
									>
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path d="m6 9 6 6 6-6" />
										</svg>
									</button>
								)}
							</li>
						))}
					</ul>
				</div>
				{/* Rendered from the manifest. */}
				<div
					class="toc-col toc-members"
					hidden={groupCount === 0}
					style={firstGroupRow > 0 ? `--first-rows:${firstGroupRow}` : undefined}
				>
					{rows.map((r) =>
						r.members ? (
							<ul class="members-group" data-group={r.slug}>
								{r.members.map((m) => (
									<li><a href={`#${m}`} title={m}>{m}</a></li>
								))}
							</ul>
						) : r.gap ? (
							<div class="members-gap" data-gap={r.slug} aria-hidden="true"></div>
						) : null,
					)}
				</div>
				{/* Scrollbar track, server-rendered so its width is reserved from the first paint. */}
				<div class="toc-scroll" aria-hidden="true" hidden={groupCount === 0}>
					<div class="toc-thumb" />
				</div>
			</div>
		</nav>
	) : (
		<div class="toc-default">
			<button class="toc-sb-toggle" type="button" aria-label="Toggle table of contents sidebar" title="Toggle sidebar">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<rect x="3" y="4" width="18" height="16" rx="2" />
					<path d="M15 4v16" />
				</svg>
			</button>
			<Default><slot /></Default>
		</div>
	)
}

{/* First-paint sizing. Inline, so it runs while parsing (no separate file to wait for). It only does the one
    thing CSS can't: thumb height = view * view / total (length / length). The main script writes the same value later. */}
<script is:inline>
	(function () {
		try {
			if (!matchMedia('(min-width: 72rem)').matches) return;
			var nav = document.querySelector('nav.api-toc');
			if (!nav) return;
			var heads = nav.querySelector('.toc-heads');
			var members = nav.querySelector('.toc-members');
			var track = nav.querySelector('.toc-scroll');
			var thumb = nav.querySelector('.toc-thumb');
			if (!heads || !members || !track || !thumb) return;
			var view = track.offsetHeight;
			var total = Math.max(heads.offsetHeight, members.hidden ? 0 : members.offsetHeight);
			if (total > view + 1) thumb.style.height = Math.max(24, (view * view) / total) + 'px';
			else track.hidden = true; // everything fits: no scrollbar
		} catch (e) {}
	})();
</script>

<script>
	const START_COLLAPSED = false; // true = sections with sub-headings start collapsed
	const REMEMBER = true; // remember which sections are collapsed, per page

	const ANCHOR = 0.35; // how far down the TOC the current row sits (0 = top, 1 = bottom)
	const TAU = 90; // ms. Slide smoothing: smaller = snappier
	const TIP_MS = 90; // ms. The "{" point moving to a new row
	const BRACE_MS = 280; // ms. The "{" fading / moving / resizing (independent of scroll speed)
	// The headings list follows a precomputed, as-straight-as-possible path; the members list is slid so the current
	// member stays level with the current heading. The shared row may wander this many rows from the anchor:
	const DRIFT = 4; // 0 = pinned (but headings move in bursts), bigger = steadier
	// The highlight (and "{") switches to the next row once the page is this far (0..1) towards it.
	const SWITCH = 0.5;
	// The curly line "{" (px):
	const CURVE = 8; // roundness of its top and bottom curves
	const TRAIL = 28; // how far its ends reach right before fading out
	const TIP = 8; // how far its middle point sticks out left
	const TIP_R = 5; // roundness of that point
	let braceId = 0;

	// Taut string: the straightest path through a corridor (one value per row between lo[i] and hi[i], first and
	// last fixed). Bends only where the corridor forces it to.
	const tautString = (lo: number[], hi: number[]) => {
		const n = lo.length;
		const pts: [number, number][] = [[0, lo[0]]];
		let i0 = 0;
		let y0 = lo[0];
		while (i0 < n - 1) {
			let lowS = -Infinity;
			let highS = Infinity;
			let iL = i0;
			let iH = i0;
			let bent = false;
			for (let j = i0 + 1; j < n; j++) {
				const d = j - i0;
				const sl = (lo[j] - y0) / d;
				const sh = (hi[j] - y0) / d;
				if (sh < lowS) {
					i0 = iL;
					y0 = lo[iL];
					bent = true;
					break;
				}
				if (sl > highS) {
					i0 = iH;
					y0 = hi[iH];
					bent = true;
					break;
				}
				if (sl > lowS) {
					lowS = sl;
					iL = j;
				}
				if (sh < highS) {
					highS = sh;
					iH = j;
				}
			}
			if (!bent) {
				pts.push([n - 1, lo[n - 1]]);
				break;
			}
			pts.push([i0, y0]);
		}
		const out: number[] = new Array(n).fill(0);
		for (let k = 0; k + 1 < pts.length; k++) {
			const [a, ya] = pts[k];
			const [b, yb] = pts[k + 1];
			for (let q = a; q <= b; q++) out[q] = ya + ((yb - ya) * (q - a)) / Math.max(1, b - a);
		}
		return out;
	};

	const init = (nav: HTMLElement) => {
		const viewEl = nav.querySelector<HTMLElement>('.toc-view');
		const heads = nav.querySelector<HTMLElement>('.toc-heads');
		const membersCol = nav.querySelector<HTMLElement>('.toc-members');
		const list = heads?.querySelector('ul');
		if (!viewEl || !heads || !membersCol || !list) return;

		const idOf = (a: HTMLAnchorElement) => decodeURIComponent(a.hash.slice(1));

		type Target = { a: HTMLAnchorElement; el: HTMLElement; group: string };
		const all: { a: HTMLAnchorElement; el: HTMLElement | null; group: string }[] = [];

		// Right list: rendered by the server, just pick the lists and gaps up.
		const groups = new Map<string, HTMLUListElement>(); // class heading id -> its member list
		const gaps = new Map<string, HTMLElement>(); // class heading id -> its gap
		membersCol.querySelectorAll<HTMLUListElement>('ul.members-group').forEach((ul) => groups.set(ul.dataset.group!, ul));
		membersCol.querySelectorAll<HTMLElement>('.members-gap').forEach((g) => gaps.set(g.dataset.gap!, g));

		// Left list: headings; each class's members follow their heading (already page order).
		const headLis = new Map<string, HTMLLIElement>();
		const parentOf = new Map<string, string>(); // heading id -> parent heading id ('' = top level)
		list.querySelectorAll<HTMLLIElement>('li').forEach((li) => {
			const a = li.querySelector('a')!;
			const slug = li.dataset.group!;
			headLis.set(slug, li);
			parentOf.set(slug, li.dataset.parent ?? '');
			all.push({ a, el: document.getElementById(idOf(a)), group: slug });
			groups.get(slug)?.querySelectorAll('a').forEach((m) => {
				all.push({ a: m, el: document.getElementById(idOf(m)), group: slug });
			});
		});

		// The accent line: ONE curly "{" SVG, redrawn every frame from the same reading position as the lists.
		const SVG = 'http://www.w3.org/2000/svg';
		const X0 = TIP + 1; // x of the vertical part (the point sticks out to its left)
		const XE = X0 + CURVE + TRAIL; // right end of the trailing curves
		const gradId = `toc-brace-${braceId++}`;
		const line = document.createElementNS(SVG, 'svg');
		line.setAttribute('class', 'toc-line');
		line.setAttribute('aria-hidden', 'true');
		line.setAttribute('width', String(XE + 1));
		line.style.left = `${-TIP}px`;
		const grad = document.createElementNS(SVG, 'linearGradient'); // fades the ends out to the right
		grad.setAttribute('id', gradId);
		grad.setAttribute('gradientUnits', 'userSpaceOnUse');
		grad.setAttribute('x1', String(X0 + CURVE));
		grad.setAttribute('x2', String(XE));
		grad.setAttribute('y1', '0');
		grad.setAttribute('y2', '0');
		for (const [offset, opacity] of [['0', '1'], ['1', '0']]) {
			const stop = document.createElementNS(SVG, 'stop');
			stop.setAttribute('offset', offset);
			stop.setAttribute('style', `stop-color: var(--sl-color-text-accent); stop-opacity: ${opacity}`);
			grad.append(stop);
		}
		const defs = document.createElementNS(SVG, 'defs');
		defs.append(grad);
		const brace = document.createElementNS(SVG, 'path');
		brace.setAttribute('fill', 'none');
		brace.setAttribute('stroke', `url(#${gradId})`);
		brace.setAttribute('stroke-width', '2');
		brace.setAttribute('stroke-linecap', 'round');
		line.append(defs, brace);
		membersCol.append(line);

		// Hand-drawn scrollbar (the lists are slid by script, never scrolled natively); the server renders the track.
		const track = viewEl.querySelector<HTMLElement>(':scope > .toc-scroll');
		const thumb = track?.querySelector<HTMLElement>('.toc-thumb');
		if (!track || !thumb) return;

		// Every row (headings and members), already in page order.
		const everything = all.filter((t): t is Target => !!t.el);
		if (!everything.length) return;

		// Rows in play: rows inside a collapsed section are left out, so everything below only sees visible rows.
		let targets: Target[] = everything;
		let n = targets.length;
		let indexOf = new Map(targets.map((t, i) => [t.a, i]));
		// For every page row (hidden too): index in `targets` of the visible row standing for it (a collapsed
		// section's own heading stands for everything inside it).
		let vis: number[] = [];

		// Collapsing: a heading with sub-headings gets a "v" button that hides its sub-headings and their members.
		const kidsSlugs = [...headLis].filter(([, li]) => li.classList.contains('has-kids')).map(([s]) => s);
		const collapsed = new Set<string>();
		const hiddenSlugs = new Set<string>(); // hidden because something above them is collapsed
		let visibleGroups = 0;
		const KEY = `toc-collapsed:${location.pathname}`;
		try {
			const raw = REMEMBER ? localStorage.getItem(KEY) : null;
			if (raw !== null) {
				for (const s of JSON.parse(raw) as string[]) if (kidsSlugs.includes(s)) collapsed.add(s);
			} else if (START_COLLAPSED) {
				for (const s of kidsSlugs) collapsed.add(s);
			}
		} catch {
			if (START_COLLAPSED) for (const s of kidsSlugs) collapsed.add(s);
		}
		const saveCollapsed = () => {
			if (!REMEMBER) return;
			try {
				localStorage.setItem(KEY, JSON.stringify([...collapsed]));
			} catch {}
		};

		// Applies `collapsed`: hides / shows rows and rebuilds the rows in play.
		const applyCollapse = () => {
			hiddenSlugs.clear();
			// headLis is in document order, so a parent is always decided before its children
			for (const slug of headLis.keys()) {
				const p = parentOf.get(slug);
				if (p && (collapsed.has(p) || hiddenSlugs.has(p))) hiddenSlugs.add(slug);
			}
			let seen = false; // a visible member list has come earlier
			visibleGroups = 0;
			for (const [slug, li] of headLis) {
				const hid = hiddenSlugs.has(slug);
				li.classList.toggle('toc-hidden', hid);
				if (li.classList.contains('has-kids')) {
					const open = !collapsed.has(slug);
					li.classList.toggle('collapsed', !open);
					li.querySelector('.toc-toggle')?.setAttribute('aria-expanded', String(open));
				}
				const ul = groups.get(slug);
				if (ul) {
					ul.classList.toggle('toc-hidden', hid);
					if (!hid) {
						seen = true;
						visibleGroups++;
					}
				} else {
					gaps.get(slug)?.classList.toggle('toc-hidden', hid || !seen);
				}
			}
			membersCol.hidden = visibleGroups === 0;
			targets = everything.filter((t) => !hiddenSlugs.has(t.group));
			n = targets.length;
			indexOf = new Map(targets.map((t, i) => [t.a, i]));
			vis = [];
			let k = -1;
			for (const t of everything) {
				if (!hiddenSlugs.has(t.group)) k++;
				vis.push(Math.max(0, k));
			}
		};
		applyCollapse();

		// Movement (wide screens only; on narrow screens the lists are just stacked).
		// The page position is ONE continuous number u ("row 41.3" = 30% of the way from row 41 to 42). Both lists
		// move in the same frame from the same eased u. The members list is slid so the current member is level with
		// the current heading; the headings list follows a taut-string path (see smoothLeft). The "{" runs its own
		// fixed-length animations when the current class changes, so it never depends on scroll speed.
		const desktop = matchMedia('(min-width: 72rem)');
		const sidebarEl = nav.closest<HTMLElement>('.right-sidebar');
		let live = false; // false while hidden or on a narrow screen
		let view = 0; // visible height of the lists
		let maxL = 0; // how far each list can slide
		let maxR = 0;
		let hasMembers = false;
		let LYs: number[] = []; // per row: its class heading's y in the left list
		let RYs: number[] = []; // per row: its y in the right list
		let BTs: number[] = []; // per row: top / bottom of its class's member list, and whether it has one (1/0)
		let BBs: number[] = [];
		let BSs: number[] = [];
		let OLs: number[] = []; // per row: left list slide when the page is exactly on that row (smoothed)
		let ORs: number[] = []; // per row: same for the right list, so heading and member are level
		let rowH = 24.25; // one row (measured exactly in layout(); matches --row-h in the CSS)
		let target = 0; // u the page is at
		let cur = 0; // u as shown (eased)
		let raf = 0;
		let lastT = 0;
		// Extra px both lists are slid by, to keep a just-toggled heading where it was on screen. Eases back to 0.
		let shiftCur = 0;
		let shiftTarget = 0;

		// The "{" as shown (top / bottom in members-list coordinates, opacity) and its animation.
		let bTop = 0;
		let bBot = 0;
		let bOp = 0;
		let bFrom = { top: 0, bot: 0, op: 0 };
		let bTo = { top: 0, bot: 0, op: 0 };
		let bStart = 0;
		let bRaf = 0;
		// The point of the "{" (centre of the active row, members-list coordinates) and its animation.
		let tipY = 0;
		let tipFrom = 0;
		let tipTo = 0;
		let tStart = 0;
		let scrollable = false; // the lists are taller than the window
		let thumbH = 0;

		// Fingerprint of everything whose size needs re-measuring, to skip pointless layout() runs.
		let lastKey = '';
		const sizeKey = () =>
			`${heads.offsetWidth}x${heads.offsetHeight}|${membersCol.offsetWidth}x${membersCol.offsetHeight}|${sidebarEl?.clientHeight ?? 0}`;

		const clamp = (v: number, max: number) => Math.max(0, Math.min(max, v));
		const snap = (v: number) => Math.round(v * (devicePixelRatio || 1)) / (devicePixelRatio || 1); // sharp text
		const topIn = (el: HTMLElement, col: HTMLElement) => el.getBoundingClientRect().top - col.getBoundingClientRect().top;
		const at = (arr: number[], u: number) => {
			const i = Math.min(Math.floor(u), n - 1);
			return i >= n - 1 ? arr[n - 1] : arr[i] + (arr[i + 1] - arr[i]) * (u - i);
		};
		const idxOf = (u: number) => Math.min(n - 1, Math.max(0, Math.floor(u + 1 - SWITCH + 1e-6)));

		// Where both lists sit at position u if heading and member shared one screen row. The right list always uses
		// this; the left uses it for its corridor (smoothLeft) and when there are no members.
		const offsets = (u: number) => {
			const LY = at(LYs, u);
			const RY = at(RYs, u);
			const A = view * ANCHOR;
			if (!hasMembers) return { offL: clamp(LY - A, maxL), offR: 0 };
			// near the very top / bottom, move the shared row rather than misalign the lists
			const hi = Math.min(LY, RY);
			const lo = Math.max(LY - maxL, RY - maxR);
			const row = lo <= hi ? Math.min(Math.max(A, lo), hi) : A;
			return { offL: clamp(LY - row, maxL), offR: clamp(RY - row, maxR) };
		};

		// Builds OLs / ORs: the steady path of the headings list and the matching path of the members list.
		const smoothLeft = () => {
			OLs = [];
			ORs = [];
			if (!hasMembers || n < 3) return;
			const A = view * ANCHOR;
			const yLo = Math.max(rowH, A - DRIFT * rowH); // highest / lowest screen y the shared row may have
			const yHi = Math.min(view - 2 * rowH, A + DRIFT * rowH);
			const old: number[] = [];
			const lo: number[] = [];
			const hi: number[] = [];
			for (let i = 0; i < n; i++) {
				const v = offsets(i).offL;
				old.push(v);
				// the members list must not run out either, or heading and member couldn't stay level
				const l = Math.max(0, LYs[i] - yHi, LYs[i] - RYs[i]);
				const h = Math.min(maxL, LYs[i] - yLo, maxR + LYs[i] - RYs[i]);
				lo.push(Math.min(l, v)); // the old position is always allowed, so the corridor is never empty
				hi.push(Math.max(h, v));
			}
			lo[0] = hi[0] = old[0]; // top of page = top of list, bottom = bottom
			lo[n - 1] = hi[n - 1] = old[n - 1];
			// Work with the shared screen row s = LY - offL. Neither list may slide backwards while scrolling down, so s
			// grows by at most min(heading step, member step) per row. Subtracting that allowance (m) turns the rule
			// into "q never goes up", enforced by tightening the corridor.
			const m: number[] = [0];
			for (let i = 1; i < n; i++) m.push(m[i - 1] + Math.max(0, Math.min(LYs[i] - LYs[i - 1], RYs[i] - RYs[i - 1])));
			const qLo = lo.map((_, i) => LYs[i] - hi[i] - m[i]);
			const qHi = lo.map((_, i) => LYs[i] - lo[i] - m[i]);
			for (let i = 1; i < n; i++) qHi[i] = Math.min(qHi[i], qHi[i - 1]);
			for (let i = n - 2; i >= 0; i--) qLo[i] = Math.max(qLo[i], qLo[i + 1]);
			for (let i = 0; i < n; i++) qLo[i] = Math.min(qLo[i], qHi[i]);
			const q = tautString(qLo, qHi);
			OLs = q.map((v, i) => clamp(LYs[i] - (v + m[i]), maxL));
			// Right list: that row's member level with its heading, interpolated row by row.
			ORs = OLs.map((v, i) => clamp(RYs[i] - LYs[i] + v, maxR));
			ORs[0] = offsets(0).offR;
			ORs[n - 1] = offsets(n - 1).offR;
		};

		// Redraw the "{" over [top, bottom] of the members list, its point at tipY (the point keeps its full
		// length and only moves up and down).
		const drawLine = (top: number, bottom: number, tipY: number, opacity: number) => {
			const t = snap(top);
			const H = Math.round(snap(bottom) - t);
			if (opacity < 0.02 || H < 8) {
				line.style.opacity = '0';
				return;
			}
			const R = Math.min(CURVE, (H - 2) / 2);
			const r = Math.min(TIP_R, Math.max(0, (H - 2 - 2 * R) / 2));
			const lo = 1 + R + r;
			const hi = H - 1 - R - r;
			const yt = Math.round(lo <= hi ? Math.min(Math.max(tipY - t, lo), hi) : H / 2);
			line.style.opacity = String(opacity);
			line.style.transform = `translateY(${t}px)`;
			line.setAttribute('height', String(H));
			brace.setAttribute(
				'd',
				`M ${XE} 1 H ${X0 + R} A ${R} ${R} 0 0 0 ${X0} ${1 + R} V ${yt - r} Q ${X0} ${yt} 1 ${yt} Q ${X0} ${yt} ${X0} ${yt + r} V ${H - 1 - R} A ${R} ${R} 0 0 0 ${X0 + R} ${H - 1} H ${XE}`,
			);
		};

		const render = () => {
			if (!live) {
				heads.style.transform = membersCol.style.transform = '';
				line.style.opacity = '0';
				track.hidden = true;
				return;
			}
			const u = clamp(cur, n - 1);
			const o = offsets(u);
			const smooth = hasMembers && OLs.length === n && ORs.length === n;
			const offL = clamp((smooth ? at(OLs, u) : o.offL) + shiftCur, maxL);
			const offR = clamp((smooth ? at(ORs, u) : o.offR) + shiftCur, maxR);
			heads.style.transform = `translateY(${-snap(offL)}px)`;
			membersCol.style.transform = `translateY(${-snap(offR)}px)`;
			drawLine(bTop, bBot, tipY, bOp);
			if (scrollable) thumb.style.transform = `translateY(${snap((n > 1 ? u / (n - 1) : 0) * (view - thumbH))}px)`;
		};

		const braceTick = (t: number) => {
			const p = Math.min(1, Math.max(0, (t - bStart) / BRACE_MS));
			const e = 1 - Math.pow(1 - p, 3); // ease-out
			bTop = bFrom.top + (bTo.top - bFrom.top) * e;
			bBot = bFrom.bot + (bTo.bot - bFrom.bot) * e;
			bOp = bFrom.op + (bTo.op - bFrom.op) * e;
			const q = Math.min(1, Math.max(0, (t - tStart) / TIP_MS));
			tipY = tipFrom + (tipTo - tipFrom) * (1 - Math.pow(1 - q, 3));
			render();
			bRaf = p < 1 || q < 1 ? requestAnimationFrame(braceTick) : 0;
		};

		// Move the "{" point to the centre of row idx's line (short fixed-length animation).
		const setTip = (idx: number, instant = false) => {
			if (RYs[idx] === undefined) return;
			const y = RYs[idx] + rowH / 2;
			if (instant) {
				tipY = tipFrom = tipTo = y;
				return;
			}
			if (y === tipTo) return;
			tipFrom = tipY;
			tipTo = y;
			tStart = performance.now();
			if (!bRaf) bRaf = requestAnimationFrame(braceTick);
		};

		// Point the "{" at row idx's class: members -> members tweens position and size; none -> members fades in
		// already in place; members -> none fades out where it is. Always runs BRACE_MS once started.
		const setBrace = (idx: number, instant = false) => {
			const has = BSs[idx] === 1;
			const to = has
				? { top: BTs[idx], bot: BBs[idx], op: 1 }
				: { top: bTo.top, bot: bTo.bot, op: 0 };
			if (!instant && to.top === bTo.top && to.bot === bTo.bot && to.op === bTo.op) return;
			// appearing from nothing: place the box straight away, only the opacity animates
			if (instant || (has && bOp < 0.02)) {
				bTop = to.top;
				bBot = to.bot;
			}
			if (instant) {
				bOp = to.op;
				bFrom = bTo = to;
				if (bRaf) {
					cancelAnimationFrame(bRaf);
					bRaf = 0;
				}
				return;
			}
			bFrom = { top: bTop, bot: bBot, op: bOp };
			bTo = to;
			bStart = performance.now();
			if (!bRaf) bRaf = requestAnimationFrame(braceTick);
		};

		const tick = (t: number) => {
			raf = 0;
			const dt = Math.min(64, t - lastT || 16);
			lastT = t;
			const k = 1 - Math.exp(-dt / TAU);
			let more = false;
			const diff = target - cur;
			if (Math.abs(diff) < 0.002) {
				cur = target;
			} else {
				cur += diff * k;
				more = true;
			}
			const sd = shiftTarget - shiftCur;
			if (Math.abs(sd) < 0.25) {
				shiftCur = shiftTarget;
			} else {
				shiftCur += sd * k;
				more = true;
			}
			if (more) raf = requestAnimationFrame(tick);
			render();
		};
		const go = (u: number) => {
			target = clamp(u, n - 1);
			if (!live || raf) return;
			lastT = performance.now();
			raf = requestAnimationFrame(tick);
		};

		// Dragging the thumb (or pressing the track) browses the TOC like the wheel does.
		let grab = 0;
		const dragTo = (e: PointerEvent) =>
			go(clamp((e.clientY - track.getBoundingClientRect().top - grab) / Math.max(1, view - thumbH), 1) * (n - 1));
		track.addEventListener('pointerdown', (e) => {
			if (!live || !scrollable) return;
			e.preventDefault();
			track.setPointerCapture(e.pointerId);
			grab = e.target === thumb ? e.clientY - thumb.getBoundingClientRect().top : thumbH / 2;
			track.classList.add('dragging');
			dragTo(e);
		});
		track.addEventListener('pointermove', (e) => {
			if (track.hasPointerCapture(e.pointerId)) dragTo(e);
		});
		const endDrag = () => track.classList.remove('dragging');
		track.addEventListener('pointerup', endDrag);
		track.addEventListener('pointercancel', endDrag);

		// Width with every section open and the scrollbar showing. The view is never narrower than this, or the
		// centred TOC would shift sideways on every collapse / expand. Measured by briefly undoing the collapse.
		const fullWidth = () => {
			const hiddenEls = [...nav.querySelectorAll<HTMLElement>('.toc-hidden')];
			const wasHidden = membersCol.hidden;
			const trackWasHidden = track.hidden;
			viewEl.style.minWidth = '';
			for (const el of hiddenEls) el.classList.remove('toc-hidden');
			membersCol.hidden = groups.size === 0;
			track.hidden = false;
			const w = viewEl.getBoundingClientRect().width;
			track.hidden = trackWasHidden;
			membersCol.hidden = wasHidden;
			for (const el of hiddenEls) el.classList.add('toc-hidden');
			return w;
		};

		const layout = () => {
			live = false;
			viewEl.style.minWidth = '';
			if (desktop.matches) {
				viewEl.style.minWidth = `${Math.ceil(fullWidth())}px`;
				// exact fractional row height (offsetHeight would round 24.25 to 24); same as --row-h in the CSS
				rowH = heads.querySelector('a')?.getBoundingClientRect().height || 24.25;
				// Empty space on top of the members list, as tall as the headings above the first VISIBLE class with
				// members, so its first member starts level with its heading.
				const firstSlug = [...groups.keys()].find((s) => !hiddenSlugs.has(s));
				const firstHead = firstSlug ? headLis.get(firstSlug)!.querySelector('a') : null;
				const firstLink = firstSlug ? groups.get(firstSlug)!.querySelector('a') : null;
				membersCol.style.paddingTop = '0px'; // measure the first member's natural top with no padding
				membersCol.style.paddingTop =
					firstHead && firstLink ? `${Math.max(0, topIn(firstHead, heads) - topIn(firstLink, membersCol))}px` : '';

				const hL = heads.offsetHeight;
				const hR = membersCol.hidden ? 0 : membersCol.offsetHeight;
				if (hL || hR) {
					// Room left in Starlight's scroll container (.right-sidebar): its height minus where the lists start
					// and the panel's bottom padding.
					const sidebar = viewEl.closest<HTMLElement>('.right-sidebar');
					const panel = viewEl.closest<HTMLElement>('.right-sidebar-panel');
					const start = viewEl.getBoundingClientRect().top - (sidebar?.getBoundingClientRect().top ?? 0) + (sidebar?.scrollTop ?? 0);
					const padBottom = panel ? parseFloat(getComputedStyle(panel).paddingBottom) || 0 : 0;
					const maxH = (sidebar?.clientHeight ?? innerHeight) - start - padBottom;
					view = Math.min(maxH, Math.max(hL, hR));
					maxL = Math.max(0, hL - view);
					maxR = Math.max(0, hR - view);
					hasMembers = visibleGroups > 0;
					viewEl.style.height = `${view}px`;
					const total = Math.max(hL, hR);
					scrollable = total > view + 1;
					thumbH = scrollable ? Math.max(24, (view * view) / total) : 0;
					track.hidden = !scrollable;
					track.style.height = `${view}px`;
					thumb.style.height = `${thumbH}px`;

					// Per-row positions in both lists.
					const headY = new Map<string, number>();
					for (const [slug, li] of headLis) headY.set(slug, topIn(li.querySelector('a')!, heads));
					const groupTop = new Map<string, number>();
					// a class heading lines up with its first member's row, not the top of the padded group box
					for (const [slug, ul] of groups) groupTop.set(slug, topIn(ul.querySelector('a')!, membersCol));
					const boxOf = new Map<string, { top: number; bottom: number }>();
					for (const [slug, ul] of groups) {
						const top = topIn(ul, membersCol);
						boxOf.set(slug, { top, bottom: top + ul.offsetHeight });
					}
					LYs = [];
					RYs = [];
					BTs = [];
					BBs = [];
					BSs = [];
					for (const t of targets) {
						const ly = headY.get(t.group)!;
						LYs.push(ly);
						const gap = gaps.get(t.group);
						let r: number;
						if (membersCol.contains(t.a)) r = topIn(t.a, membersCol);
						else if (groupTop.has(t.group)) r = groupTop.get(t.group)!;
						else if (gap && !gap.classList.contains('toc-hidden')) r = topIn(gap, membersCol); // class without members: its gap
						else r = ly; // before the first class with members: level with itself
						RYs.push(r);
						const b = boxOf.get(t.group);
						BTs.push(b ? b.top : r);
						BBs.push(b ? b.bottom : r);
						BSs.push(b ? 1 : 0);
					}
					smoothLeft();
					live = true;
				}
			}
			if (!live) {
				scrollable = false;
				OLs = [];
				ORs = [];
				track.hidden = true;
				viewEl.style.height = '';
				membersCol.style.paddingTop = '';
			} else {
				// sizes may have changed: put the "{" straight onto the current class (no animation)
				setBrace(Math.max(0, active), true);
				setTip(Math.max(0, active), true);
			}
			lastKey = sizeKey();
			render();
		};

		// Reading line = where the browser puts a jump-link target (the page's scroll-padding-top), so a row you
		// jump to sits at the line. The 1px absorbs sub-pixel rounding.
		const getOffset = () => (parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0) + 1;

		// Row positions are measured once (document coordinates) and reused every scroll frame, which then only
		// reads scrollY. `dirty` is set whenever the page layout may have changed.
		let rowTops: number[] = [];
		let readLine = 0;
		let docH = 0;
		let dirty = true;
		const measurePositions = () => {
			const sy = scrollY;
			rowTops = everything.map((t) => t.el.getBoundingClientRect().top + sy);
			readLine = getOffset();
			docH = document.documentElement.scrollHeight;
			dirty = false;
		};

		// Page position as a continuous row number. Measured on EVERY row (collapsed ones too) so a collapsed section
		// keeps its real stretch of the page, then mapped onto visible rows via `vis`.
		const pageU = () => {
			if (dirty) measurePositions();
			const sy = scrollY;
			const topOf = (i: number) => rowTops[i] - sy;
			const N = everything.length;
			let r = readLine;
			// near the page bottom the last rows can't reach the line: ease it down so u stays continuous
			const maxScroll = docH - innerHeight;
			const lastAtBottom = topOf(N - 1) - (maxScroll - sy);
			if (lastAtBottom > r) r += (lastAtBottom - r) * Math.min(1, Math.max(0, (sy - (maxScroll - innerHeight)) / innerHeight));
			// last row at or above the line (binary search, rows are in page order)
			let lo = 0;
			let hi = N - 1;
			let i = -1;
			while (lo <= hi) {
				const mid = (lo + hi) >> 1;
				if (topOf(mid) <= r) {
					i = mid;
					lo = mid + 1;
				} else hi = mid - 1;
			}
			if (i < 0) return 0;
			if (i >= N - 1) return vis[N - 1];
			const a = topOf(i);
			const b = topOf(i + 1);
			const frac = b > a ? Math.min(1, Math.max(0, (r - a) / (b - a))) : 0;
			return vis[i] + (vis[i + 1] - vis[i]) * frac;
		};

		// Highlight: the last row the page has reached, and its class.
		let active = -1;
		const highlight = (u: number) => {
			const idx = idxOf(u);
			if (idx === active) return;
			if (active >= 0) targets[active]?.a.removeAttribute('aria-current');
			active = idx;
			const now = targets[idx];
			now.a.setAttribute('aria-current', 'true');
			for (const [slug, li] of headLis) li.classList.toggle('active-group', slug === now.group);
			// headings above the current one (e.g. "Extensions" while on "Cog") get the soft grey too
			const above = new Set<string>();
			for (let p = parentOf.get(now.group); p; p = parentOf.get(p)) above.add(p);
			for (const [slug, li] of headLis) li.classList.toggle('active-ancestor', above.has(slug));
			for (const [slug, ul] of groups) ul.classList.toggle('active-group', slug === now.group);
		};

		let first = true;
		const update = () => {
			const u = pageU();
			highlight(u);
			if (first) {
				first = false;
				cur = target = u;
				if (live) {
					setBrace(idxOf(u), true);
					setTip(idxOf(u), true);
				}
				render();
			} else {
				// the "{" belongs to the row the PAGE is on; wheel-browsing the TOC doesn't move it to another class
				if (live) {
					setBrace(active);
					setTip(active);
				}
				shiftTarget = 0; // the page moved: follow it again
				go(u);
			}
		};

		// A section was collapsed / expanded: rebuild, re-measure and redraw. `pin` is the clicked heading and its
		// screen y; the lists are slid so it stays exactly there instead of jumping to the page's reading position.
		const refresh = (pin?: { a: HTMLAnchorElement; y: number }) => {
			applyCollapse();
			nav.querySelectorAll('[aria-current]').forEach((el) => el.removeAttribute('aria-current'));
			active = -1;
			first = true;
			shiftCur = shiftTarget = 0;
			layout();
			update();
			const h = pin ? indexOf.get(pin.a) : undefined;
			if (pin && live && h !== undefined) {
				const smooth = hasMembers && OLs.length === n && ORs.length === n;
				const baseL = smooth ? at(OLs, h) : offsets(h).offL;
				cur = target = h;
				// heading y on screen = LYs[h] - (baseL + shift): solve for the shift that puts it at pin.y
				shiftCur = shiftTarget = LYs[h] - pin.y - baseL;
				render();
			}
		};

		// Clicking a "v" button collapses / expands that heading's section.
		list.addEventListener('click', (e) => {
			const btn = (e.target as Element).closest<HTMLElement>('.toc-toggle');
			const li = btn?.closest<HTMLElement>('li');
			const slug = li?.dataset.group;
			const a = li?.querySelector('a');
			if (!btn || !li || !slug || !a) return;
			e.preventDefault();
			const y = a.getBoundingClientRect().top - viewEl.getBoundingClientRect().top;
			if (collapsed.has(slug)) collapsed.delete(slug);
			else collapsed.add(slug);
			saveCollapsed();
			refresh({ a, y });
		});

		// Wheel over the TOC browses it by hand (glides row by row) until the page scrolls again. It never leaks to
		// the page while the cursor is over the TOC.
		viewEl.addEventListener(
			'wheel',
			(e) => {
				if (!live || e.ctrlKey) return;
				const d = (e.deltaY * (e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? view : 1)) / rowH;
				e.preventDefault();
				go(target + d);
			},
			{ passive: false },
		);
		// Keyboard focus glides to the link. Not for mouse clicks: focus happens on mouse DOWN, and gliding then would
		// slide the link out from under the cursor before mouse UP.
		viewEl.addEventListener('focusin', (e) => {
			if (!(e.target as Element).matches(':focus-visible')) return;
			const a = (e.target as Element).closest('a');
			const i = a ? indexOf.get(a) : undefined;
			if (i !== undefined) go(i);
		});

		let ticking = false;
		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				ticking = false;
				update();
			});
		};

		// Re-measure at most once per frame, and only if something it depends on changed size (layout() forces
		// several reflows).
		let layoutQueued = false;
		let forceNext = false;
		const queueLayout = (force = false) => {
			forceNext ||= force;
			if (layoutQueued) return;
			layoutQueued = true;
			requestAnimationFrame(() => {
				layoutQueued = false;
				const f = forceNext;
				forceNext = false;
				if (!f && sizeKey() === lastKey) return;
				layout();
				onScroll();
			});
		};

		addEventListener('scroll', onScroll, { passive: true });
		addEventListener('resize', () => {
			dirty = true;
			queueLayout(true);
		});
		desktop.addEventListener('change', () => {
			dirty = true;
			queueLayout(true);
		});
		// Lists change size when fonts load or the panel is resized; the sidebar when it becomes a floating card.
		const ro = new ResizeObserver(() => queueLayout());
		ro.observe(heads);
		ro.observe(membersCol);
		if (sidebarEl) ro.observe(sidebarEl);

		// The page's own rows move when the page changes size (code tabs, fonts, images, left sidebar collapsing).
		const pageRo = new ResizeObserver(() => {
			dirty = true;
			onScroll();
		});
		pageRo.observe(document.documentElement);
		const pageContent = document.querySelector('.sl-markdown-content');
		if (pageContent) pageRo.observe(pageContent);

		layout();
		update();
	};

	document.querySelectorAll<HTMLElement>('nav.api-toc').forEach((nav) => {
		try {
			init(nav);
		} catch (err) {
			console.error(err);
		}
	});

	// Collapsing the whole right sidebar (same idea as the left one, see Sidebar.astro): the button next to
	// "On this page" collapses it (or pins it open again); collapsed, it hides at the right edge, peeks out as a
	// floating card when the mouse touches that edge, and closes when the mouse leaves the card.
	{
		const root = document.documentElement;
		const wide = matchMedia('(min-width: 72rem)'); // the right sidebar only exists at this width
		const EDGE = 6; // px from the right edge that triggers the peek
		const CLOSE_DELAY = 150; // ms before the peeking card slides away
		const KEY = 'toc-sidebar-collapsed';
		const pane = () => document.querySelector<HTMLElement>('.right-sidebar');

		let closeTimer = 0;
		const cancelClose = () => {
			clearTimeout(closeTimer);
			closeTimer = 0;
		};
		const peek = (on: boolean) => {
			cancelClose();
			root.toggleAttribute('data-toc-peek', on);
		};
		const scheduleClose = () => {
			if (closeTimer) return;
			closeTimer = window.setTimeout(() => {
				closeTimer = 0;
				peek(false);
			}, CLOSE_DELAY);
		};

		document.addEventListener('click', (event) => {
			if (!(event.target as Element).closest('.toc-sb-toggle')) return;
			if (root.hasAttribute('data-toc-collapsed')) root.removeAttribute('data-toc-collapsed');
			else root.setAttribute('data-toc-collapsed', '');
			peek(false);
			try {
				localStorage.setItem(KEY, root.hasAttribute('data-toc-collapsed') ? '1' : '0');
			} catch {}
		});

		document.addEventListener('mousemove', (event) => {
			if (!wide.matches || !root.hasAttribute('data-toc-collapsed')) return;
			// clientWidth excludes the page's own scrollbar, so the edge is the strip just left of it
			if (event.clientX >= root.clientWidth - EDGE) {
				peek(true);
			} else if (root.hasAttribute('data-toc-peek')) {
				const r = pane()?.getBoundingClientRect();
				const inside =
					!!r && event.clientX >= r.left && event.clientX <= r.right && event.clientY >= r.top && event.clientY <= r.bottom;
				if (inside) cancelClose();
				else scheduleClose();
			}
		});
		document.addEventListener('mouseleave', () => {
			if (root.hasAttribute('data-toc-peek')) scheduleClose();
		});
	}
</script>

<style is:global>
	/* Jump links put their target --toc-jump-gap below the top bar (Starlight adds 1.5rem, which showed a strip of
	   the previous section). The TOC's reading line is read from this same value, so jumping and highlighting agree. */
	html:root:has(.api-toc) {
		--toc-jump-gap: 0rem;
		scroll-padding-top: calc(var(--toc-jump-gap) + var(--sl-nav-height) + var(--sl-mobile-toc-height));
	}
	@media (min-width: 72em) {
		html:root:has(.api-toc) {
			scroll-padding-top: calc(var(--toc-jump-gap) + var(--sl-nav-height));
		}
	}

	/* One row: line-height 1.25 x font size + 0.25rem padding above and below (see ".api-toc a"). The members
	   list's top padding and the gap heights are calculated from it, so they are exact on first paint. */
	.api-toc {
		--row-h: calc(1.25 * var(--sl-text-xs) + 0.5rem);
	}

	/* Font size, link colour, hover colour and the h2 style are inherited from Starlight's .right-sidebar-panel. */
	.api-toc ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.api-toc li {
		position: relative;
	}
	.api-toc a {
		--pad-inline: 0.5rem;
		display: block;
		border-radius: 0.25rem;
		font-size: var(--sl-text-xs); /* same as Starlight's; stated so --row-h can rely on it */
		padding-block: 0.25rem;
		padding-inline: calc(1rem * var(--d, 0) + var(--pad-inline)) var(--pad-inline);
		line-height: 1.25;
	}
	.api-toc a[aria-current='true'] {
		color: var(--sl-color-text-accent);
	}
	.api-toc .toc-members[hidden],
	.api-toc .toc-scroll {
		display: none;
	}

	/* Rows inside a collapsed section (headings, member lists, gaps). */
	.api-toc .toc-hidden {
		display: none !important;
	}

	/* The "v" button after headings that have sub-headings. Points down when open, right when collapsed. */
	.api-toc li.has-kids {
		display: flex;
		align-items: stretch;
	}
	.api-toc li.has-kids > a {
		flex: none;
		padding-inline-end: 0.25rem;
	}
	.api-toc .toc-toggle {
		flex: none;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.25rem;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0.25rem;
		background: none;
		color: var(--sl-color-gray-3);
		cursor: pointer;
	}
	.api-toc .toc-toggle:hover,
	.api-toc .toc-toggle:focus-visible {
		color: var(--sl-color-white);
		background: color-mix(in srgb, var(--sl-color-white) 10%, transparent);
	}
	.api-toc .toc-toggle svg {
		width: 0.9rem;
		height: 0.9rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: transform 0.15s ease;
	}
	.api-toc li.collapsed > .toc-toggle svg {
