---
import Default from '@astrojs/starlight/components/Sidebar.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SocialIcons from './SocialIcons.astro';
import ThemeSelect from './ThemeSelect.astro';
---

<div class="sb-top">
	<div class="sb-head">
		<div class="sb-title"><SiteTitle /></div>
		<button class="sb-toggle sb-close" type="button" aria-label="Toggle sidebar" title="Toggle sidebar">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<rect x="3" y="4" width="18" height="16" rx="2"></rect>
				<path d="M9 4v16"></path>
			</svg>
		</button>
	</div>
	<Search />
</div>

<Default />

<div class="sb-bottom">
	<div class="sb-card">
		<SocialIcons />
		<ThemeSelect />
	</div>
</div>

<script>
	const root = document.documentElement;
	const desktop = matchMedia('(min-width: 50rem)');
	const EDGE = 6; // px from the left screen edge that triggers the peek
	const CLOSE_DELAY = 150; // ms before the peeking sidebar slides away
	const pane = document.querySelector<HTMLElement>('.sidebar-pane');

	const save = () => {
		try {
			localStorage.setItem('sidebar-collapsed', root.hasAttribute('data-sidebar-collapsed') ? '1' : '0');
		} catch {}
	};

	let closeTimer = 0;
	const cancelClose = () => {
		clearTimeout(closeTimer);
		closeTimer = 0;
	};
	const scheduleClose = () => {
		if (closeTimer) return; // already counting down
		closeTimer = window.setTimeout(() => {
			closeTimer = 0;
			peek(false);
		}, CLOSE_DELAY);
	};
	const peek = (on: boolean) => {
		cancelClose();
		root.toggleAttribute('data-sidebar-peek', on);
	};

	// Button: collapsed (or peeking) -> pin open; open -> collapse.
	document.addEventListener('click', (event) => {
		if (!(event.target as Element).closest('.sb-toggle')) return;
		if (root.hasAttribute('data-sidebar-collapsed')) {
			root.removeAttribute('data-sidebar-collapsed');
		} else {
			root.setAttribute('data-sidebar-collapsed', '');
		}
		peek(false);
		save();
	});

	// Hover the left edge to peek; move off the floating sidebar to close it again.
	document.addEventListener('mousemove', (event) => {
		if (!desktop.matches || !root.hasAttribute('data-sidebar-collapsed')) return;
		if (event.clientX <= EDGE) {
			peek(true);
		} else if (root.hasAttribute('data-sidebar-peek')) {
			const r = pane?.getBoundingClientRect();
			const inside =
				!!r && event.clientX >= r.left && event.clientX <= r.right && event.clientY >= r.top && event.clientY <= r.bottom;
			if (inside) cancelClose();
			else scheduleClose();
		}
	});
	// Mouse left the window entirely.
	document.addEventListener('mouseleave', () => {
		if (root.hasAttribute('data-sidebar-peek')) scheduleClose();
	});
</script>
