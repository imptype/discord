from enum import IntEnum
from typing import Any
import aiohttp

class CloseCode(IntEnum):
  AUTHENTICATION_FAILED = ...
  INVALID_SHARD = ...
  SHARDING_REQUIRED = ...
  INVALID_API_VERSION = ...
  INVALID_INTENTS = ...
  DISALLOWED_INTENTS = ...

class ReconnectCode(IntEnum):
  UNKNOWN_ERROR = ...

class ResetCode(IntEnum):
  INVALID_SEQUENCE = ...
  SESSION_TIMED_OUT = ...

class Opcode(IntEnum):
  DISPATCH = ...
  HEARTBEAT = ...
  IDENTIFY = ...
  RESUME = ...
  RECONNECT = ...
  INVALID_SESSION = ...
  HELLO = ...
  HEARTBEAT_ACK = ...

def format_debug(payload, redact = ...) -> Any: ...

class Connection:
  ws: aiohttp.ClientWebSocketResponse
  http: Any # TODO
  token: Any # TODO
  masked_token: Any # TODO
  intents: Any # TODO
  on_event: Any # TODO
  sequence: Any # TODO
  session_id: Any # TODO
  resume_url: Any # TODO
  heartbeat_task: Any # TODO
  acked: Any # TODO
  last_beat: Any # TODO

  def __init__(self, http, token, intents, on_event) -> None: ...

