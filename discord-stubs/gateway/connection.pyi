from typing import Any
from enum import IntEnum
import aiohttp

class CloseCode(IntEnum):
  AUTHENTICATION_FAILED = ...
  INVALID_SHARD = ...
  SHARDING_REQUIRED = ...
  INVALID_API_VERSION = ...
  INVALID_INTENTS = ...
  DISALLOWED_INTENTS = ...

class ReconnectCode(IntEnum):
  UNKNOWN_ERROR = ...

class ResetCode(IntEnum):
  INVALID_SEQUENCE = ...
  SESSION_TIMED_OUT = ...

class Opcode(IntEnum):
  DISPATCH = ...
  HEARTBEAT = ...
  IDENTIFY = ...
  RESUME = ...
  RECONNECT = ...
  INVALID_SESSION = ...
  HELLO = ...
  HEARTBEAT_ACK = ...

def format_debug(payload, redact = ...) -> Any: ...

class Connection:
  ws: aiohttp.ClientWebSocketResponse

  def __init__(self, http, token, intents, on_event) -> None: ...

  async def run(self) -> Any: ...

  async def session(self) -> Any: ...

  async def handle(self, payload) -> Any: ...

  async def heartbeat(self, interval) -> Any: ...

  def since_beat(self) -> Any: ...

  async def beat(self) -> Any: ...

  async def identify(self) -> Any: ...

  async def resume(self) -> Any: ...

  def reset(self) -> Any: ...

  async def send(self, payload) -> Any: ...

  http: Any
  token: Any
  masked_token: Any
  intents: Any
  on_event: Any
  sequence: Any
  session_id: Any
  resume_url: Any
  heartbeat_task: Any
  acked: Any
  last_beat: Any
